					<addressOffset>0xB7</addressOffset>
					<size>0x08</size>
					<resetValue>0x00</resetValue>
					<fields>
						<field>
							<name>RB_UEP_R_RES_MASK</name>
							<description>endpoint 6 has control over the received response</description>
