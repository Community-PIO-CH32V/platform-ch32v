          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0xB0FFC040</resetValue>
          <fields>
            <field>
              <name>REFRESH</name>
              <description>Configurable refresh command command</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GLRST</name>
              <description>Configurable global reset commands</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
