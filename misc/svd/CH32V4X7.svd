            </field>
            <field>
              <name>MREGW</name>
              <description>Configurable register write commands</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>MREGR</name>
              <description>Configurable register read commands</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>			
          </fields>
        </register>		
		
        <register>
          <name>DMACR</name>
          <displayName>DMACR</displayName>
          <description>PSRAM DMA Control Register</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TOWBL_TOUT</name>
              <description>Pause time between bursts, in HCLK</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMA_ONEBL</name>
              <description>DMA burst length</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MEMORY_SIZE</name>
              <description>Memory Data Width</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>DAT_DIR</name>
              <description>Data transmission direction</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMAEN</name>
              <description>DMA Enables</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
          </fields>
        </register>			
		
        <register>
          <name>DATA_NUM</name>
          <displayName>DATA_NUM</displayName>
          <description>PSRAM Data Transmission Quantity Register</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA_NUM</name>
              <description>Number of data transfers</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>		
          </fields>
        </register>			

        <register>
          <name>DMA_MEM_ADDR</name>
          <displayName>DMA_MEM_ADDR</displayName>
          <description>Start address register of memory during DMA transmission</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DMA_MEM_ADDR</name>
              <description>The start address of the memory (single-byte alignment) when DMA is in transit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>		
          </fields>
        </register>					
		
        <register>
          <name>DMA_PSRAM_ADDR</name>
          <displayName>DMA_PSRAM_ADDR</displayName>
          <description>Start Address Register of PSRAM during DMA Transmission</description>
          <addressOffset>0x24</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DMA_PSRAM_ADDR</name>
              <description>The start address of the PSRAM when DMA is transmitted (32 bytes aligned in 4 mode and 16 bytes aligned in 2 mode)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>		
          </fields>
        </register>	
		
        <register>
          <name>ISR</name>
          <displayName>ISR</displayName>
          <description>PSRAM Interrupt State Register</description>
          <addressOffset>0x28</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>AEIF</name>
              <description>Address error interrupt flag, address exceeds MEM capacity</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>CENEIF</name>
              <description>CEM Error Interrupt Flag, write 1 to clear zero</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMATF</name>
              <description>DMA bus transmission completion flag, write 1 to clear zero</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>	
          </fields>
        </register>			
		
        <register>
          <name>IER</name>
          <displayName>IER</displayName>
          <description>PSRAM Interrupt Error Enable Register</description>
          <addressOffset>0x2C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>AEIEN</name>
              <description>Address error interrupt enable</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CENEIEN</name>
              <description>CEM error interrupt marker enable</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMATEN</name>
              <description>DMA bus transmission completion enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>	
          </fields>
        </register>			
	
        <register>
          <name>STATUS</name>
          <displayName>STATUS</displayName>
          <description>PSRAM controller state machine register</description>
          <addressOffset>0x30</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PSRAM_STATE</name>
              <description>PSRAM controller state machine</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>	
          </fields>
        </register>	
	
        <register>
          <name>CECFG</name>
          <displayName>CECFG</displayName>
          <description>PSRAM CE Pulse Configuration Register</description>
          <addressOffset>0x34</addressOffset>
          <size>0x20</size>
          <resetValue>0x000004B0</resetValue>
          <fields>
            <field>
              <name>CEPWEN</name>
              <description>CE pulse width detection enables</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CELPD</name>
              <description>Maximum duration of CE low pulse 
			  (excluding withdrawal of half sleep):
				T= N*PSRAM clock period</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>	
          </fields>
        </register>			
		
        <register>
          <name>LATENCY</name>
          <displayName>LATENCY</displayName>
          <description>PSRAM Read/Write Delay Register</description>
          <addressOffset>0x38</addressOffset>
          <size>0x20</size>
          <resetValue>0x00050505</resetValue>
          <fields>
            <field>
              <name>RLATENCY</name>
              <description>Read the delay</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WLATENCY</name>
              <description>Write the delay</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>	
          </fields>
        </register>		
      </registers>	
  	</peripheral>		
	
  	</peripherals>	
	</device>