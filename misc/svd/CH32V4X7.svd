            </field>
            <field>
              <name>SR_LB</name>
              <description>Configurable synchronous read (linear burst) commands</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SW</name>
              <description>Configurable synchronous write commands</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>SR</name>
              <description>Configurable synchronous read commands</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>			
          </fields>
        </register>			
        <register>
          <name>CMD1_CFG</name>
          <displayName>CMD1_CFG</displayName>
