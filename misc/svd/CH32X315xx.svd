          <addressOffset>0xE0</addressOffset>
          <size>0x8</size>
          <resetValue>0x86</resetValue>
          <fields>
			<field>
              <name>RB_EP_TX_ISO_MODE</name>
              <description>1 means that the current endpoint is a synchronous endpoint.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_SEQ_AUTO</name>
              <description>Allow the software to write R16_EPn_ST->EP_SEQ_NUM</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_ERDY_AUTO</name>
              <description>ERDY automatic mode, the hardware will send ERDY, no software control required; 
			  The synchronous endpoint recommends clearing the bit</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_EOB_MODE</name>
              <description>If a short packet is sent, then EOB/LPF in ACK-TP</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_FIFO_CFG</name>
              <description>The object being operated on when the access offset address is 0xC~0xF</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_FIFO_MODE</name>
              <description>A bit of 1 indicates that the current endpoint is using the FIFO mode, 
			  and the start and end addresses of the FIFO should be configured before the bit is 1</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_CHAIN_AUTO</name>
              <description>CHAIN automatically switches mode, this mode is recommended</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
		 </fields>
        </register>

		<register>
          <name>UEP2_TX_CR</name>
          <displayName>UEP2_TX_CR</displayName>
          <description>Endpoint 2 Control Register</description>
          <addressOffset>0xE1</addressOffset>
          <size>0x8</size>
          <resetValue>0x10</resetValue>
          <fields>			
			<field>
              <name>RB_EP_TX_ERDY_NUMP</name>
              <description>The hardware sends the NUMP field of ERDY-TP, 
			  and the general configuration value is the number of bursts supported. 
			  For example, if you support level 16 bursts, the field is configured to be 16. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_CHAIN_CLR</name>
              <description>Write 1 to clear all CHAIN configuration values and statuses.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_CLR</name>
              <description>Write 1 to clear all configuration values and states of the endpoint, except for UEP_CFG</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_HALT</name>
              <description>Endpoint stop, high efficiency, endpoint stop response STALL to DPH</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
		 </fields>
        </register>

