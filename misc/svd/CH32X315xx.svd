          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>LINK_LMP_TX_DATA0</name>
              <description>User-defined data sent to HP [31:0]. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>		
		 </fields>
        </register>

		<register>
          <name>LINK_LMP_TX_DATA1</name>
          <displayName>LINK_LMP_TX_DATA1</displayName>
          <description>USB Custom HP Data 1 Register</description>
          <addressOffset>0x68</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>LINK_LMP_TX_DATA1</name>
              <description>User-defined data sent to HP [63:32]. </description>
