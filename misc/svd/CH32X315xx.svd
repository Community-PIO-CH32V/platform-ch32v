    <peripheral>
      <name>USBSS</name>
      <description>USB3.0 ultra-high speed host /device controller</description>
      <groupName>USBSS</groupName>
      <baseAddress>0x40038000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
		<interrupt>
		<name>USBSS</name>
		<description>USBSS global interrupt</description>
		<value>53</value>
		</interrupt>
		<interrupt>
		<name>USBSS_LINK</name>
		<description>USBSS LINK interrupt</description>
		<value>54</value>
		</interrupt>		
		<interrupt>
		<name>USBSSWakeUP</name>
		<description>USBSS wake-up interrupt</description>
		<value>57</value>
		</interrupt>
      <registers>
        <register>
          <name>CTRL</name>
          <displayName>CTRL</displayName>
          <description>Flash capecity register</description>
          <addressOffset>0x70</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RB_DMA_EN</name>
              <description>Enable DMA</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_USB_CLR_ALL</name>
              <description>Reset all software configuration registers, high efficiency, need software clearing</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_FORCE_RST</name>
              <description>To reset the protocol layer and FIFO module, software clearing is required</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_DMA_MODE</name>
              <description>When performing burst DPH transmission, the operation of the next packet</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_SETUP_FLOW</name>
