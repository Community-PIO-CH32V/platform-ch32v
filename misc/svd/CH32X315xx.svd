              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
          </fields>
        </register>
		<register>
          <name>STATUS</name>
          <displayName>STATUS</displayName>
          <description>USBSS Status Register</description>
          <addressOffset>0x74</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>RB_UIF_TRANSFER</name>
              <description>USB transaction completion interrupt flag bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_UDIF_SETUP</name>
              <description>Device mode: Receives the SETUP transaction completion interrupt flag bit</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_UDIF_STATUS</name>
              <description>Device mode: Receives the STATUS transaction to complete the interrupt flag</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_UIF_RX_PING</name>
              <description>Receive PING-TP completion interrupt flag bit</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_UIF_ITP</name>
              <description>Send ITP completion interrupt flag bit</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_UIF_FIFO_TXOV</name>
              <description>Send FIFO overflow interrupt flag bits</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_UIF_FIFO_RXOV</name>
              <description>Receive FIFO overflow interrupt flag bits</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_EP_ID</name>
              <description>If multiple endpoints have an interrupt flag at the same time, 
			  the priority order is as follows (high-> low): Synchronous transmission > control transmission>block 
			  transmission/interrupted transmission, the smaller the endpoint number of the same endpoint type, 
			  the higher the priority.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_EP_DIR</name>
              <description>If the transmission and reception have an interrupt flag 
			  at the same time, the bit is 1, which prioritizes transmission 
			  (SETUP/STATUS independent interrupt)</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
		 </fields>
        </register>
		<register>
          <name>R32_UH_TX_DMA_U3EP0_TX_DMA</name>
          <displayName>R32_UH_TX_DMA_U3EP0_TX_DMA</displayName>
          <description>Sending Buffer Address Register</description>
          <addressOffset>0x8C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>U3EP0_TX_DMA</name>
              <description>Endpoint 0 sends the buffer start address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>

		<register>
          <name>R32_UH_RX_DMA_U3EP0_RX_DMA</name>
          <displayName>R32_UH_RX_DMA_U3EP0_RX_DMA</displayName>
          <description>Receive Buffer Address Register</description>
          <addressOffset>0x90</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>U3EP0_RX_DMA</name>
              <description>Endpoint 0 receives the buffer start address.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>
		
		<register>
          <name>ITP</name>
          <displayName>ITP</displayName>
          <description>The Interval register for the ITP package in USB</description>
          <addressOffset>0x78</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>REG_ITP_INTERVAL</name>
              <description>The Bus interval Counter field in the received ITP.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-only</access>
            </field>			
		 </fields>
        </register>

		<register>
          <name>ITP_ADJ</name>
          <displayName>ITP_ADJ</displayName>
          <description>Interval adaptive registers for ITP packets in USB</description>
          <addressOffset>0x7C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>ITP_ADJ_CR</name>
              <description>In device mode, the Bus Interval Adjustment Control field in the received ITP. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>		
			<field>
              <name>ITP_DELAYED</name>
              <description>In device mode, the delayed bit of the Link Control Word in the received ITP is 1 when the ITP is delayed. </description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>ITP_DELTA</name>
              <description>The high 13bit (delta) of ITS in the ITP received in device mode represents the time difference from 
			  the start of the current ITP packet to the boundary of the previous bus interval.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-only</access>
            </field>			
		 </fields>
        </register>

		<register>
          <name>UEP_TX_EN</name>
          <displayName>UEP_TX_EN</displayName>
          <description>Endpoint Send Enable Register</description>
          <addressOffset>0x80</addressOffset>
          <size>0x10</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>RB_EP_TX_EN</name>
              <description>Endpoint 1~15 Upload Enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>15</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>

		<register>
          <name>UEP_rX_EN</name>
          <displayName>UEP_rX_EN</displayName>
          <description>Endpoint Receive Enable Register</description>
          <addressOffset>0x82</addressOffset>
          <size>0x10</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>RB_EP_RX_EN</name>
              <description>Endpoint 1~15 downpass Enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>15</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>

		<register>
          <name>UEP0_TX_CTRL</name>
          <displayName>UEP0_TX_CTRL</displayName>
          <description>Endpoint 0 Transmit Control Register</description>
          <addressOffset>0x84</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>RB_EP0_TX_LEN</name>
              <description>The endpoint sends length registers with a maximum value of 512B.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP0_TX_SEQ</name>
              <description>The current sequence number of the endpoint is automatically cleared after receiving the SETUP transaction.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP0_TX_RES</name>
              <description>Response to ACK-TP</description>
              <bitOffset>21</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP0_TX_ERDY</name>
              <description>The bit writes 1, sends ERDY, and the hardware of the bit is automatically cleared after the ERDY is sent.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP0_TX_PP</name>
              <description>The PP bit in the received ACK-TP.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_EP0_TX_FLOW</name>
              <description>Flag to complete NRDY-TP send (answer)</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_UIF_EP0_TX_ACT</name>
              <description>The upload transaction is interrupted, the software writes 0 to clear zero, and the hardware sets it to 1.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP0_RX_CTRL</name>
          <displayName>UEP0_RX_CTRL</displayName>
          <description>Endpoint 0 Receives Control Register</description>
          <addressOffset>0x88</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
			<field>
              <name>RB_EP0_RX_LEN</name>
              <description>The endpoint receives the length register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_EP0_RX_SEQ</name>
              <description>The serial number that the endpoint expects to receive</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP0_RX_RES</name>
              <description>Response to DPH</description>
              <bitOffset>21</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP0_RX_ERDY</name>
              <description>The bit writes 1, sends ERDY, and the hardware of the bit is automatically cleared after the ERDY is sent</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP0_RX_PP</name>
              <description>The PP bit in the received DPH</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_UIF_EP0_RX_ACT</name>
              <description>The downstream transaction completes the interrupt flag, 
			  the software writes 0 to clear zero, and the hardware sets it to 1</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_CFG</name>
          <displayName>UEP1_TX_CFG</displayName>
          <description>Endpoint 1 configures the registers</description>
          <addressOffset>0xC0</addressOffset>
          <size>0x8</size>
          <resetValue>0x86</resetValue>
          <fields>
			<field>
              <name>RB_EP_TX_ISO_MODE</name>
              <description>1 means that the current endpoint is a synchronous endpoint.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_SEQ_AUTO</name>
              <description>Allow the software to write R16_EPn_ST->EP_SEQ_NUM</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_ERDY_AUTO</name>
              <description>ERDY automatic mode, the hardware will send ERDY, no software control required; 
			  The synchronous endpoint recommends clearing the bit</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_EOB_MODE</name>
              <description>If a short packet is sent, then EOB/LPF in ACK-TP</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_FIFO_CFG</name>
              <description>The object being operated on when the access offset address is 0xC~0xF</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_FIFO_MODE</name>
              <description>A bit of 1 indicates that the current endpoint is using the FIFO mode, 
			  and the start and end addresses of the FIFO should be configured before the bit is 1</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_CHAIN_AUTO</name>
              <description>CHAIN automatically switches mode, this mode is recommended</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_CR</name>
          <displayName>UEP1_TX_CR</displayName>
          <description>Endpoint 1 Control Register</description>
          <addressOffset>0xC1</addressOffset>
          <size>0x8</size>
          <resetValue>0x10</resetValue>
          <fields>			
			<field>
              <name>RB_EP_TX_ERDY_NUMP</name>
              <description>The hardware sends the NUMP field of ERDY-TP, 
			  and the general configuration value is the number of bursts supported. 
			  For example, if you support level 16 bursts, the field is configured to be 16. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_CHAIN_CLR</name>
              <description>Write 1 to clear all CHAIN configuration values and statuses.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_CLR</name>
              <description>Write 1 to clear all configuration values and states of the endpoint, except for UEP_CFG</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_HALT</name>
              <description>Endpoint stop, high efficiency, endpoint stop response STALL to DPH</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_SEQ</name>
          <displayName>UEP1_TX_SEQ</displayName>
          <description>Endpoint 1 serial number register</description>
          <addressOffset>0xC2</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_TX_EP_SEQ_NUM</name>
              <description>The current serial number of the endpoint is writable in non-SEQ_AUTO mode and read-only in SEQ_AUTO mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>					
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_ST</name>
          <displayName>UEP1_TX_ST</displayName>
          <description>Endpoint 1 state register</description>
          <addressOffset>0xC3</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_TX_CHAIN_EN</name>
              <description>CHAIN enabled state, corresponding to 4 independent CHAINs</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>	
			<field>
              <name>RB_TX_CHAIN_RES</name>
              <description>CHAIN response state, corresponding to 4 independent CHAINs</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_TX_EP_ERDY_REQ</name>
              <description>It indicates that it is currently in the sending ERDY;
				Writing 1 to that bit will send ERDY, used in non-ERDY_AUTO mode.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_TX_EP_FC_ST</name>
              <description>The endpoint is currently in the flow control state, write 1 to clear it</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_TX_EP_INT_FLAG</name>
              <description>The endpoint is currently interrupted, the bit is read-only, and if all CHAIN_IF is 0, the bit is 0, otherwise it is 1.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_CHAIN_CR</name>
          <displayName>UEP1_TX_CHAIN_CR</displayName>
          <description>Endpoint 1 CHAIN control register</description>
          <addressOffset>0xC4</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_TX_RET_SEL</name>
              <description>When the FORCE_RET is valid, this bit indicates the returned CHAIN state and configuration.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_TX_FORCE_RET</name>
              <description>This bit effectively forces the return of the selected CHAIN state machine configuration</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_TX_CUR_CFG</name>
              <description>The currently configured CHAIN serial number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_TX_CUR_USE</name>
              <description>The CHAIN serial number currently in use.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>			
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_CHAIN_ST</name>
          <displayName>UEP1_TX_CHAIN_ST</displayName>
          <description>Endpoint 1 CHAIN status register</description>
          <addressOffset>0xC5</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_TX_CHAIN_EN</name>
              <description>The currently used CHAIN enables the hardware to 
			  automatically set 1 after the UEP_CHAIN_NUMP register is configured, and the CHAIN is automatically cleared 
			  after the transmission is completed.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>			
			<field>
              <name>RB_TX_CHAIN_IF</name>
              <description>The bit is only written, write 1 to release the current CHAIN_IF;
				The current CHAIN NUMP_EMPTY is 1 to cause this outage.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>			
			<field>
              <name>RB_TX_EOB_LPF</name>
              <description>The EOB/LPF bits in the last pack of DPH of the current CHAIN</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_TX_NUMP_EMPTY</name>
              <description>If the NUMP in the current CHAIN is 0, then the position is 1</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_TX_DPH_PP</name>
              <description>The current status of the PP bit in the DPH.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_TX_CHAIN_NO</name>
              <description>The CHAIN serial number that is currently generating the outage.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_CHAIN_LEN</name>
          <displayName>UEP1_TX_CHAIN_LEN</displayName>
          <description>Endpoint 1 CHAIN sends the last packet length</description>
          <addressOffset>0xC6</addressOffset>
          <size>0x10</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>CHAIN_TX_LEN</name>
              <description>The CHAIN sends the length of the last packet.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_CHAIN_EXP_NUMP</name>
          <displayName>UEP1_TX_CHAIN_EXP_NUMP</displayName>
          <description>Number of NUMPs expected to be sent by endpoint 1</description>
          <addressOffset>0xC8</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>TX_CHAIN_EXP_NUMP</name>
              <description>The number of DPP packets that can be sent by the CHAIN that has been completed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP1_TX_CHAIN_NUMP</name>
          <displayName>UEP1_TX_CHAIN_EXP_NUMP</displayName>
          <description>Number of NUMPs sent by endpoint 1</description>
          <addressOffset>0xC9</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>TX_CHAIN_NUMP</name>
              <description>The number of DPP packets that have been transmitted; When the CHIN_EN is 0, 
			  the register is automatically cleared at the same time as the UEP_CHAIN_NUMP is written.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

