              <name>RB_EP_RX_RET_SEL</name>
              <description>When the FORCE_RET is valid, this bit indicates the returned CHAIN state and configuration.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_RX_FORCE_RET</name>
              <description>This bit effectively forces the return of the selected CHAIN state machine configuration</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_RX_CUR_CFG</name>
              <description>The currently configured CHAIN serial number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_EP_RX_CUR_USE</name>
              <description>The CHAIN serial number currently in use.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>			
		 </fields>
        </register>

		<register>
          <name>UEP3_RX_CHAIN_ST</name>
          <displayName>UEP3_RX_CHAIN_ST</displayName>
          <description>Endpoint 3 CHAIN status register</description>
          <addressOffset>0x115</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_EP_RX_CHAIN_EN</name>
              <description>The currently used CHAIN enables the hardware to 
			  automatically set 1 after the UEP_CHAIN_NUMP register is configured, and the CHAIN is automatically cleared 
			  after the transmission is completed.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>			
			<field>
              <name>RB_EP_RX_CHAIN_IF</name>
              <description>The bit is only written, write 1 to release the current CHAIN_IF;
			The interrupt occurs when any of the following conditions are met</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_RX_LPF_FLAG</name>
              <description>Only the synchronous downhaul endpoint is used to receive the LPF status in the DPH currently received.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_EP_RX_ISO_PKT_ERR</name>
              <description>Only the synchronous downhaul endpoint is used, and there is a CRC32 error in the currently receiving DPP</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>			
			<field>
              <name>RB_EP_RX_NUMP_EMPTY</name>
              <description>If the NUMP in the current CHAIN is 0, then the position is 1</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_EP_RX_DPH_PP</name>
              <description>The current status of the PP bit in the DPH.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RB_EP_RX_CHAIN_NO</name>
              <description>The CHAIN serial number that is currently generating the outage.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
		 </fields>
        </register>

		<register>
          <name>UEP3_RX_CHAIN_LEN</name>
          <displayName>UEP3_RX_CHAIN_LEN</displayName>
          <description>The  length of the last packet received by the Endpoint 3 CHAIN</description>
          <addressOffset>0x116</addressOffset>
          <size>0x10</size>
          <resetValue>0x00</resetValue>
          <fields>			
