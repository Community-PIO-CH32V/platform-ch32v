              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_UX_EXIT_FAIL</name>
              <description>Exit UX failure interrupt enable</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>CONFIG_DONE_INT_EN</name>
              <description>Link receives or sends to PORT_Capability LMP interrupt enable</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RX_CAP_FAIL_INT_EN</name>
              <description>The CAP of the other party receiving the link cannot be combined with its own CAP to make an interrupt enable of the uplink and downlink ports</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_RX_LMP_TOUT</name>
              <description>Receive LMP timeout interrupt enable</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_TX_LMP</name>
              <description>Successfully entering U0, you can send HP packet interrupt enable</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>					
			<field>
              <name>LINK_IE_RX_LMP</name>
              <description>Receive a link command flag interrupt enable</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>LINK_IE_RX_DET</name>
              <description>Link enters Rx.Detect state interrupt enabled</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>LINK_IE_LOOPBACK</name>
              <description>Link enters loopback mode for testing and fault isolation interrupt enablement</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>LINK_IE_COMPLIANCE</name>
              <description>Link entry compliance tests, interrupted with compatibility tests or physical layer conformance tests</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>LINK_IE_HPBUF_FULL</name>
              <description>HP_BUF send FIFO full interrupt enable</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>LINK_IE_HPBUF_EMPTY</name>
              <description>HP_BUF send FIFO null interrupt enable</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>LINK_IE_HOT_RST</name>
              <description>HOT RESET, which uses the reset interrupt of the TS1/TS2 ordered set</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>LINK_IE_U3_WAKEUP</name>
              <description>In the U3 state, receive the low-frequency periodic signal (LFPS) wake-up interrupt enable</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>	
			<field>
              <name>LINK_IE_WARM_RST</name>
              <description>Warm reset (unconnected) interrupt enable with LPFS</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_UX_EXIT</name>
              <description>Receiving a request to exit the UX interrupts the enable</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_TXEQ</name>
              <description>LINK into POLLING_RXEQ for receiver equalization training interrupt enablement</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_TERM_PRES</name>
              <description>LINK entry RX_DETECT to detect the impedance detection interruption of the trace segment of the remote receiver enables the following functions</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_UX_REJ</name>
              <description>Send LGO_ Ux, receive LXU interrupt enablement that refuses to enter the ux send</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_U3_WK_TOUT</name>
              <description>When requesting an exit U3 command timeout interrupt enabled</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_GO_U0</name>
              <description>LINK in U0 interrupt enabled</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_GO_U1</name>
              <description>LINK is in U1 interrupt enable</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_GO_U2</name>
              <description>LINK is in 2 interrupt enable</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_GO_U3</name>
              <description>LINK is in U3 interrupt enable</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_DISABLE</name>
              <description>LINK in DISABLED interrupt enable</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_INACTIVE</name>
              <description>LINK is in INACTIVE interrupt enable</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_RECOVERY</name>
              <description>Due to the error LINK in RECOVERY interrupt enable</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IE_READY</name>
              <description>LINK is initialized, including two ports before (Heade Sequence Number Advertisement)
			  and (RX Headr Buffer Credit Advertisement) interrupt enabled</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>	

		<register>
          <name>LINK_INT_FLAG</name>
          <displayName>LINK_INT_FLAG</displayName>
          <description>LINK Interrupt Flag Register</description>
          <addressOffset>0x0C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>LINK_IF_STATE_CHG</name>
              <description>LINK_RESET reset to 0 (write 1 clear)</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_U1_TOUT</name>
              <description>U1 timeout interrupt; (write 1 clear)</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_U2_TOUT</name>
              <description>U2 timeout interrupt; (write 1 clear)</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_UX_FAIL</name>
              <description>Failed to enter the UX interrupted; (write 1 clear)</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_TX_WARMRST</name>
              <description>Interruption at the end of the WARM_RESET send; (write 1 clear)</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_UX_EXIT_FAIL</name>
              <description>Exit UX fails to interrupt; (write 1 clear)</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>CONFIG_DONE_FLAG</name>
              <description>The link receives or sends to PORT_Capability LMP interrupt (write 1 to zero)</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RX_CAP_FAIL_FLAG</name>
              <description>The CAP of the other party received by the link cannot be combined with its own CAP to form an interrupt
			  at the uplink and downlink ports (write 1 to clear it)</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_RX_LMP_TOUT</name>
              <description>After LINK initialization is complete, 
			  the Port Capabilities/Configuration LMPs timeout (20us) interrupt flag is exchanged. </description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_TX_LMP</name>
              <description>LINK initializes the interrupt flag, 
			  and the software configures to send Port Capabilities LMP for port capability switching.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_RX_LMP</name>
              <description>Receiving LMP interrupt flags</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_RX_DET</name>
              <description>After entering the RX_DETECT state interrupt flag, this position 1, 
			  the software will set the PWR_MODE to P2, ready for RX_DETECT</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_LOOPBACK</name>
              <description>LINK enters the LOOPBACK state interrupt flag.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_COMPLIANCE</name>
              <description>LINK enters the COMPLIANCE status interrupt flag.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_HPBUF_FULL</name>
              <description>Header Packet buffer full interrupt flag.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_HPBUF_EMPTY</name>
              <description>Header Packet buffer empty interrupt flag.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_HOT_RST</name>
              <description>The device receives the HOT RESET interrupt flag</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_WAKEUP</name>
              <description>The power supply is in P3 mode and the LFPS signal interrupt flag is detected.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_WARM_RST</name>
              <description>The WARM_RESET state change (valid-> invalid or invalid->valid)
			  received by the device interrupted the flag. </description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_UX_EXIT</name>
              <description>LINK receives the LFPS ready to exit U1/U2/U3 request interrupt flag, 
			  after this position 1, the software should set the PWR_MODE to P0, after setting the PWR_MODE to P0, 
			  the UX exit timer starts to time, after reaching U1_EXIT_TIMER,
			  U2_EXIT_TIMER, U3_WAKE_TIMER, LINK exits the Ux state, Go to Recovery</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_TXEQ</name>
              <description>LINK enters TXEQ state outage flag:
				Indicates completion of the POLLING handshake and waits for the software
				to set the PWR_MODE to P0 in order to enter the TXEQ stage.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_TERM_PRES</name>
              <description>TERM disconnected or connection interrupted flag detected.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_UX_REJ</name>
              <description>LINK refuses to enter low power mode (U1/U2) interrupt flag. </description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_U3_WK_TOUT</name>
              <description>Wake up timeout interrupt flag (10ms) from U3. </description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_GO_U0</name>
              <description>LINK enters the U0 state interrupt flag.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_GO_U1</name>
              <description>LINK enters the U1 state interrupt flag.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_GO_U2</name>
              <description>LINK enters the U2 state interrupt flag.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>	
			<field>
              <name>LINK_IF_GO_U3</name>
              <description>LINK enters the U3 state interrupt flag.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_DISABLE</name>
              <description>LINK to enter the SS.DISABLE state interrupt flag</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_INACTIVE</name>
              <description>LINK enters the SS.INACTIVE state interrupt flag</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_RECOVERY</name>
              <description>LINK enters the SS.RECOVERY status interrupt flag</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_IF_READY</name>
              <description>LINK enters the U0 state and completes the LINK initialization interrupt flag.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>	

		<register>
          <name>LINK_STATUS</name>
          <displayName>LINK_STATUS</displayName>
          <description>LINK Status Register</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000430</resetValue>
          <fields>			
			<field>
              <name>LINK_HPBUF_EMPTY</name>
              <description>HP buffer is empty.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_HPBUF_FULL</name>
              <description>HP buffer is full.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_HPBUF_IDLE</name>
              <description>HP_BUF the status of sending FIFO IDLE</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_U3_SLEEP_ALLOW</name>
              <description>The link is in the U3 state, allowing sleep. </description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_U2_SLEEP_ALLOW</name>
              <description>The link is in the U2 state, allowing sleep. </description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_RXDET_SLEEP_ALLOW</name>
              <description>The link is in the RXDET state, allowing sleep. </description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_WAKUP</name>
              <description>A link wake-up signal is received.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_RX_LFPS</name>
              <description>The link receives an LFPS signal.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_RX_DETECT</name>
              <description>The link is at P2 and is RX_DETECT underway. </description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_RX_UX_EXIT_REQ</name>
              <description>Received a request to exit the UX</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_STATE</name>
              <description>Link Status</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_TXEQ</name>
              <description>The link is in POLLING_RXEQ.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_PD_MODE_MASK</name>
              <description>Link Power Status</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_READY</name>
              <description>When the LINK enters the U0 state, the position 1 will be automatically 
			  cleared after the initialization (broadcast) is completed, 
			  and the bit will be automatically cleared when it exits the U0 state.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_BUSY</name>
              <description>LINK busy state, the bit is 1 when the switching PD_MODE is completed, 
			  and the hardware will automatically clear it after the switching is completed. </description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_RX_WARM_RST</name>
              <description>Receive a valid WARM_RESET signal from the host 
			  (the hardware will automatically pull up after receiving the host's WARM_RESET 18ms).</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_RX_TERM_PRES</name>
              <description>After RX_DETECT, if there is a receiver terminal resistor, the bit is 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>			
		 </fields>
        </register>	

		<register>
          <name>LINK_ITP_PRE</name>
          <displayName>LINK_ITP_PRE</displayName>
          <description>LINK ITP timeout mode register</description>
          <addressOffset>0x17</addressOffset>
          <size>0x8</size>
          <resetValue>0x80</resetValue>
          <fields>			
			<field>
              <name>ITP_PRE</name>
              <description>ITP Timeout Mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
		 </fields>
        </register>	

		<register>
          <name>LINK_U2_INACT_TIMER</name>
          <displayName>LINK_U2_INACT_TIMER</displayName>
          <description>LINK U2 Inactivity Timeout Counter Threshold Register</description>
          <addressOffset>0x1D</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>U2_INACTIVE_TIMER</name>
              <description>Values of the inactivity timeout counter threshold for U2</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>	

		<register>
          <name>LINK_U1_WKUP_FILTER</name>
          <displayName>LINK_U1_WKUP_FILTER</displayName>
          <description>U1 Wake Up LFPS Effective Time Register</description>
          <addressOffset>0x28</addressOffset>
          <size>0x8</size>
          <resetValue>0x4A</resetValue>
          <fields>			
			<field>
              <name>U1_WKUP_FILTER</name>
              <description>The effective duration of the LFPS received when U1 exits. 
			  When the receiving LFPS reaches this time, the received U1 EXIT can be considered valid, and the transmitted LFPS_LAST is raised, and the handshake is successful, which defaults to 600ns. 
			  U1_WKUP_FILTER [7]: the unit of time that controls U1_WKUP_FILTER [6:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>	

		<register>
          <name>LINK_U2_WKUP_FILTER</name>
          <displayName>LINK_U2_WKUP_FILTER</displayName>
          <description>U2 Wake LFPS Effective Time Register</description>
          <addressOffset>0x2C</addressOffset>
          <size>0x8</size>
          <resetValue>0x02</resetValue>
          <fields>			
			<field>
              <name>U2_WKUP_FILTER</name>
              <description>When the received LFPS reaches this time, the transmitted LFPS_LAST is raised and the handshake is successful, 
			  and the received U2 EXIT is considered valid, the duration is (n)us, and the default is 2us. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>		
		 </fields>
        </register>	

		<register>
          <name>LINK_U3_WKUP_FILTER</name>
          <displayName>LINK_U3_WKUP_FILTER</displayName>
          <description>U3 Wake LFPS Effective Time Register</description>
          <addressOffset>0x30</addressOffset>
          <size>0x8</size>
          <resetValue>0x64</resetValue>
          <fields>			
			<field>
              <name>U3_WKUP_FILTER</name>
              <description>When the received LFPS reaches this time, the transmitted LFPS_LAST is raised and the handshake is successful, 
			  and the received U3 EXIT is considered valid, the duration is (n)us, and the default is 100us. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>		
		 </fields>
        </register>	

		<register>
          <name>LINK_ISO_DLY</name>
          <displayName>LINK_ISO_DLY</displayName>
          <description>LINK Synchronous Delay Register</description>
          <addressOffset>0x40</addressOffset>
          <size>0x10</size>
          <resetValue>0x28</resetValue>
          <fields>			
			<field>
              <name>LINK_ISOCH_DLY</name>
              <description>The delay time for serial bit stream parsing to parallel data is 40ns by default,
			  as the device writes the delay information to the register, 
			  which is invalid by 3 bits lower (because the clock frequency is 125MHz, the delay time needs to be set to 8*n). </description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>		
		 </fields>
        </register>	

		<register>
          <name>LINK_LPM_CR</name>
          <displayName>LINK_LPM_CR</displayName>
          <description>Link Power Management Registers</description>
          <addressOffset>0x50</addressOffset>
          <size>0x10</size>
          <resetValue>0x0000</resetValue>
          <fields>			
			<field>
              <name>PHY_CHSEL_AUTO</name>
              <description>The channel type of the PHY layer is automatically selected</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LPM_RXDET_EN</name>
              <description>When the LPM count reaches the desired value, it is confirmed that a device is connected to the PHY RXDET_EXP this bit is elevated.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LPM_TERM_PRESENT</name>
              <description>The PHY layer detects the device connection. </description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LPM_TERM_CHG</name>
              <description>The connected device changes, plugs in the device or unplugs the device. </description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LPM_EN</name>
              <description>CLKLPM is fixed at 12MHz, when LINK_PD_MODE=3 and LPM_EN=0 and OSCOUTEN=0 and PLLALIV=0,
			  CLKOSCO will stop and the crystal oscillator will stop</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LPM_RST</name>
              <description>Reset signal for LPM-related registers</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RXDET_EXP</name>
              <description>Detect external device counter registers. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>	
		 </fields>
        </register>	

		<register>
          <name>LINK_LMP_PORT_CAP</name>
          <displayName>LINK_LMP_PORT_CAP</displayName>
          <description>PORT_CAP Register</description>
          <addressOffset>0x54</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>LINK_LMP_RX_CAP_VLD</name>
              <description>Upon receipt of a valid PORT_CAP_LMP, the protocol stipulates that 
			  the two parties will exchange PORT_CAP_LMP within 20us after entering the U0 state</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_LMP_TX_CAP_VLD</name>
              <description>PORT Capability configuration completion flag (software operation, write 1 clear 0)</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_SPEED</name>
              <description>[24] Position 1, indicating that the supported device supports USB3.2 Gen1 (5Gbps). </description>
              <bitOffset>24</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RX_CAP_TIEBRK</name>
              <description>Tiebreaker, used for PORT type quorum when two PORTs (REG_PORT_CAP[17:16]=11) with both uplink and 
			  downlink capabilities are connected, the port with the higher value becomes the downstream port, 
			  and if the tiebreakers of the two PORTs are equal, the PORT_CAP will be re-exchanged.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RX_CAP_OTG</name>
              <description>OTG bits in LMP that receive Port Capability; Used for whether to go to this OTG function. </description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RX_CAP_DIR</name>
              <description>[17]: If the position is 1, it means that the port can be configured as a downbound port; 
				[18]: If the position is 1, it means that the port can be configured as an upbound port. </description>
              <bitOffset>17</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_DOWN_MODE</name>
              <description>Decide on your port configuration according to your and the other party's PORT Capability.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>CFG_TIEBREAKER</name>
              <description>Configure the Tiebreaker bit in the LMP of the Port Capability of this port;
				The higher the value, the lower exit.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>CFG_UP_MODE</name>
              <description>Configure the Direction bit in the LMP of the port capability of this port</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>CFG_DOWN_MODE</name>
              <description>Configure the Direction low in the LMP of the port capability</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>CFG_OTG_CAPABLE</name>
              <description>Configure the OTG bits in the LMP of the port capability of this port; Used for whether to 
			  go to this OTG function.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>AUTO_CAP</name>
              <description>When the automatic configuration of Port Capability fails, the bit is automatically cleared</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
		 </fields>
        </register>	

		<register>
          <name>LINK_LMP_RX_DATA0</name>
          <displayName>LINK_LMP_RX_DATA0</displayName>
          <description>LMP Receive Data 0 Register</description>
          <addressOffset>0x58</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>LINK_LMP_RX_DATA0</name>
              <description>After LMP reception is complete, HP data is stored in this register [31:0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>		
		 </fields>
        </register>	

