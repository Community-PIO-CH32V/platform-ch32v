          <name>UEP4_TX_DMA_OFS</name>
          <displayName>UEP4_TX_DMA_OFS</displayName>
          <description>DMA offset length of Endpoint 4</description>
          <addressOffset>0x12A</addressOffset>
          <size>0x10</size>
          <resetValue>0x0400</resetValue>
          <fields>			
			<field>
              <name>CHAIN_TX_DMA_OFS</name>
              <description>The offset address of the DPP in the CHAIN.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
