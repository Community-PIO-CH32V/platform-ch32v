              <name>CHAIN_DMA_BA</name>
              <description>In normal mode:
				The DMA start address of the CHAIN receiving data.
				In FIFO mode:
				The FIFO start address is 16~23 bits of the mapping address in SRAM;
				The FIFO ends 16~23 bits of the mapped address in SRAM.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>	
		
		<register>
          <name>LINK_CFG</name>
          <displayName>LINK_CFG</displayName>
          <description>LINK Configuration Register</description>
          <addressOffset>0x00</addressOffset>
          <size>0x20</size>
          <resetValue>0xC0000128</resetValue>
          <fields>			
			<field>
              <name>RB_LINK_RESET</name>
              <description>LINK reset, including the reset status machine and all interrupt flags, is highly effective.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_TOUT_MODE</name>
              <description>protocol version</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_U1_PING_EN</name>
              <description>U1 sends PING_FPFS enable</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_SKP_MODE</name>
              <description>SKP rejection control for descrambling</description>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_U2_ALLOW</name>
              <description>High efficiency, after receiving the LGO_U2, 
			  the response LAU allows it to enter the U2 state,
			  otherwise after receiving the LGO_U2, the response LXU refuses to enter the U2 state</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_U1_ALLOW</name>
              <description>High efficiency, after receiving the LGO_U1, the response LAU is allowed to enter the U1 state, 
			  otherwise the response LXU refuses to enter the U1 state after receiving the LGO_U1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_LTSSM_MODE</name>
              <description>The link state machine enters DISABLE mode</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_LOOKBACK_ACT</name>
              <description>Used in LOOPBACK mode for LOOPBACK host control pattern transmission (LOOPBACK slave holds 0), 
			  ACT is a high-level signal that lasts for a period of time</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_LOOPBACK_EN</name>
              <description>Allow to enter the LOOPBACK enable bit, high efficiency, use with the LOOKBACK enable in TX/RX_TS_CFG [3], both are valid,
			  LINK can enter the LOOKBACK mode (used to enable the LOOPBACK slave data loop and error counting, the LOOPBACK host maintains 0). </description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
			<field>
              <name>RB_LINK_U2_DET_EN</name>
              <description>Detection method of connected devices in U2 state</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_CP78_SEL</name>
              <description>In Compliance Pattern 7/8, send a length of consecutive 0 or consecutive 1</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_TX_DEEMPH</name>
              <description>Transmitter De-Emphasis control</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_TX_SWING</name>
              <description>Transmitter signal swing control, low swing power consumption, but affect the transmission distance</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_RX_EQ_EN</name>
              <description>Receiver equalization enables control, protocol specifics are optional</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_LFPS_RX_PD</name>
              <description>LFPS receive control, where the bit 1 indicates that LFPS receive is disabled.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_COMPLIANCE_EN</name>
              <description>POLLING_LFPS whether the timeout enters COMPLIANCE mode</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_PHY_RESET</name>
              <description>PIPE Interface Reset</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_SS_PLR_SWAP</name>
              <description>Swap SSTX and SSRX polarity as follows</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_RX_TERM_EN</name>
              <description>Receiving terminal resistance control</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_LINK_DOWN_MODE</name>
              <description>Peripheral Type</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>			
		
		<register>
          <name>LINK_CTRL</name>
          <displayName>LINK_CTRL</displayName>
          <description>LINK Control Register</description>
          <addressOffset>0x04</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000013</resetValue>
          <fields>			
			<field>
              <name>LINK_RX_TS_CFG</name>
              <description>Received link control</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>LINK_TX_TS_CFG</name>
              <description>Link Configuration for Sending TS1/TS2 Training Sequences</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_TX_LGO_U3</name>
              <description>After the bit is valid, it will be sent LGO_U3, high effectiveness, and the hardware will be automatically cleared</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_TX_LGO_U2</name>
              <description>After the bit is valid, it will send LGO_U2, high efficiency, and the hardware will be automatically cleared;
				If the other party responds with LXU, it indicates that it refuses to enter the U2 state; 
				If the query LINK status is U2, it indicates that the other party accepts to enter the U2 low-power state, 
				and the software should change the current power mode to P2.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_TX_LGO_U1</name>
              <description>After the bit is valid, it will send LGO_U1, high efficiency, and the hardware will be automatically cleared.
				If the other party responds with LXU, it indicates that it refuses to enter U1 mode;
				If the query LINK status is U1, it indicates that the other party accepts to enter the U1 low-power state, 
				and the software should change the current power mode to P1.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_POLLING_EN</name>
              <description>High validity, if the SS.RX_DETECT detects the TERM, the POLLING handshake will be performed after the software sets the bit to be valid.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_U3_WKUP_EN</name>
              <description>Receive U3 exti LPFS signal enable</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_TX_UX_EXIT</name>
              <description>High efficiency, hardware automatic clearing</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_TX_WARM_RST</name>
              <description>High effectiveness, cleared by software. This bit is valid and will send WARM_RESET.
				In device mode: After detecting that the host has continuously sent WARM_RESET for 18 ms,
				the device controller will automatically declare that it has detected WARM_RESET and reset it.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_GO_RX_DET</name>
              <description>Before setting this bit, the PD_MODE should be set to P2 mode, and the LINK should be set to enter the SS.RX_DETECT, 
			  and the software query TERM_PRESENT know whether there is a connection or whether the connection is disconnected.
			  High effectiveness, automatic clearing.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_GO_RECOVERY</name>
              <description>Set the LINK to SS.RECOVERY, which is highly effective and the hardware is automatically cleared.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_GO_INACTIVE</name>
              <description>Set LINK to SS.INACTIVE, high efficiency, hardware automatic clearing.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_GO_DISABLED</name>
              <description>RW	Set LINK to SS.DISABLED, which is highly effective and requires software to clear it.
				If the hardware automatically goes to SS.DIABLED, then the bit is automatically set to 1 by the hardware.
				In device mode, if the USB2.0 bus reset is received, the software should first set the PD_MODE to P2 mode, and then clear this bit, 
				LTSSM will automatically enter the SS.RX_DETECT, the device will be detected 8 times (every 12ms), if no TERM is detected, it will enter the DISABLE state, 
				and communicate in USB2.0 mode at the same time. 
				In host mode, a BUS_RESET signal should be sent through the USB2.0 controller, the software should first set the PD_MODE to P2 mode, 
				then clear this bit, and if a TERM is detected, a POLLING_LFPS handshake will be made. 
				Otherwise, the software should set the power mode to P3 and communicate in USB2.0 mode.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>LINK_PD_MODE</name>
              <description>Configure the current power mode of the PHY, corresponding to PO/P1/P2/P3 in the PIPE</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>		
		 </fields>
        </register>			
		
		<register>
          <name>LINK_INT_CTRL</name>
          <displayName>LINK_INT_CTRL</displayName>
          <description>LINK Interrupt Enable Register</description>
          <addressOffset>0x08</addressOffset>
