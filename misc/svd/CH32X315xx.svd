          <name>UEP4_TX_DMA</name>
          <displayName>UEP4_TX_DMA</displayName>
          <description>DMA start address of Endpoint 4</description>
          <addressOffset>0x12C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>CHAIN_TX_DMA</name>
              <description>In normal mode:
				The DMA start address of the CHAIN sending data.
				In FIFO mode:
				The FIFO start address is 16~23 bits of the mapping address in SRAM;
				The FIFO ends 16~23 bits of the mapped address in SRAM.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

