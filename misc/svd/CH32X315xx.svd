              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_TX_ERDY_MODE</name>
              <description>Use in device mode</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_UIE_TRANSFER</name>
              <description>USB transaction completion interrupt enabled</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_UDIE_SETUP</name>
              <description>Device mode: Receive SETUP transaction to complete interrupt enablement</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
            <field>
              <name>RB_UDIE_STATUS</name>
              <description>Device mode: Receive STATUS transaction to complete interrupt enable</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_UIE_RX_PING</name>
              <description>Receive PING-TP to complete the interrupt enablement</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_UIE_ITP</name>
              <description>Send ITP to complete interrupt enable</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_UIE_FIFO_TXOV</name>
              <description>Sending FIFO Overflow Interrupt Enabled</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_UIE_FIFO_RXOV</name>
