          <addressOffset>0xD6</addressOffset>
          <size>0x10</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_EP_RX_CHAIN_RX_LEN</name>
              <description>The currently completed CHAIN receives the length of the last package.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP1_RX_CHAIN_MAX_NUMP</name>
          <displayName>UEP1_RX_CHAIN_EXP_NUMP</displayName>
          <description>Number of NUMPs that endpoint 1 can receive</description>
          <addressOffset>0xD8</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RX_CHAIN_MAX_NUMP</name>
              <description>The number of DPP packets that the CHAIN can receive.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP1_RX_CHAIN_NUMP</name>
          <displayName>UEP1_RX_CHAIN_EXP_NUMP</displayName>
          <description>Number of NUMPs received by endpoint 1</description>
          <addressOffset>0xD9</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>TX_CHAIN_NUMP</name>
              <description>The number of DPP packets that the CHAIN has received.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP1_RX_DMA_OFS</name>
          <displayName>UEP1_RX_DMA_OFS</displayName>
          <description>DMA offset length of endpoint 1</description>
          <addressOffset>0xDA</addressOffset>
          <size>0x10</size>
          <resetValue>0x0400</resetValue>
          <fields>			
			<field>
              <name>CHAIN_DMA_OFS</name>
              <description>The offset address of the DPP in the CHAIN.</description>
