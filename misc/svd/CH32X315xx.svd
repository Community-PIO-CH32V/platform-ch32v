          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>CHAIN_TX_DMA</name>
              <description>In normal mode:
				The DMA start address of the CHAIN sending data.
				In FIFO mode:
				The FIFO start address is 16~23 bits of the mapping address in SRAM;
				The FIFO ends 16~23 bits of the mapped address in SRAM.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP3_TX_CFG</name>
          <displayName>UEP3_TX_CFG</displayName>
          <description>Endpoint 3 configures the registers</description>
          <addressOffset>0x100</addressOffset>
          <size>0x8</size>
          <resetValue>0x86</resetValue>
          <fields>
			<field>
              <name>RB_EP_TX_ISO_MODE</name>
              <description>1 means that the current endpoint is a synchronous endpoint.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_SEQ_AUTO</name>
              <description>Allow the software to write R16_EPn_ST->EP_SEQ_NUM</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_ERDY_AUTO</name>
              <description>ERDY automatic mode, the hardware will send ERDY, no software control required; 
			  The synchronous endpoint recommends clearing the bit</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_EOB_MODE</name>
              <description>If a short packet is sent, then EOB/LPF in ACK-TP</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
			<field>
              <name>RB_EP_TX_FIFO_CFG</name>
              <description>The object being operated on when the access offset address is 0xC~0xF</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_FIFO_MODE</name>
              <description>A bit of 1 indicates that the current endpoint is using the FIFO mode, 
			  and the start and end addresses of the FIFO should be configured before the bit is 1</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_TX_CHAIN_AUTO</name>
              <description>CHAIN automatically switches mode, this mode is recommended</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
		 </fields>
        </register>

