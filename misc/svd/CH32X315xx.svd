    <peripheral>
      <name>STK</name>
      <description>SysTick</description>
      <groupName>STK</groupName>
      <baseAddress>0xE000F000</baseAddress>
      <addressBlock>
        <offset>0x00</offset>
        <size>0xFFF</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>STK_CTLR</name>
          <displayName>STK_CTLR</displayName>
          <description>System count control register</description>
          <addressOffset>0x00</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>STE</name>
              <description>System counter enable control bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>STIE</name>
              <description>Counter interrupt enable control bit</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STCLK</name>
              <description>Counter Clock Source Selection Bit</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>STRE</name>
              <description>Auto Reload Count Enable Bit</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>MODE</name>
              <description>Counting Mode</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>			
          </fields>
        </register>
        <register>
          <name>STK_SR</name>
          <displayName>STK_SR</displayName>
          <description>System counter interrupt status register</description>
          <addressOffset>0x04</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CNTIF</name>
              <description>Systick Interrupt Flag</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
            <field>
              <name>SWIE</name>
              <description>software Interrupt trigger enable</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>		
          </fields>
        </register>
        <register>
          <name>STK_CNTL</name>
          <displayName>STK_CNTL</displayName>
          <description>System counter low bit register</description>
          <addressOffset>0x08</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>		
            <field>
              <name>CNT</name>
              <description>Systick counter register low 32 bit </description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>		
          </fields>
        </register>
        <register>
          <name>STK_CMPLR</name>
          <displayName>STK_CMPLR</displayName>
          <description>System counter comparison low bit register</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CMP</name>
              <description>Set the comparison counter value to 32 bits lower : STK interrupts are triggered 
			  when the upcount CMP register value is equal to the CNT count value or when the downcount CMP register
			  value is equal to 0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>				
          </fields>
        </register>
      </registers>
    </peripheral>			

