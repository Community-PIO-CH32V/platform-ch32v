          <addressOffset>0x126</addressOffset>
          <size>0x10</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>CHAIN_TX_LEN</name>
              <description>The CHAIN sends the length of the last packet.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

