          <name>UEP4_TX_CHAIN_EXP_NUMP</name>
          <displayName>UEP4_TX_CHAIN_EXP_NUMP</displayName>
          <description>Number of NUMPs expected to be sent by Endpoint 4</description>
          <addressOffset>0x128</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>TX_CHAIN_EXP_NUMP</name>
              <description>The number of DPP packets that can be sent by the CHAIN that has been completed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

		<register>
          <name>UEP4_TX_CHAIN_NUMP</name>
          <displayName>UEP4_TX_CHAIN_EXP_NUMP</displayName>
          <description>Number of NUMPs sent by Endpoint 4</description>
          <addressOffset>0x129</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>TX_CHAIN_NUMP</name>
              <description>The number of DPP packets that have been transmitted; When the CHIN_EN is 0, 
			  the register is automatically cleared at the same time as the UEP_CHAIN_NUMP is written.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

