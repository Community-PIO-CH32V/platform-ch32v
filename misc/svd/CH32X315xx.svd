              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>		
		 </fields>
        </register>

		<register>
          <name>LINK_LMP_RX_DATA2</name>
          <displayName>LINK_LMP_RX_DATA2</displayName>
          <description>LMP Receives Data 2 Register</description>
          <addressOffset>0x60</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>			
			<field>
              <name>LINK_LMP_RX_DATA2</name>
              <description>After LMP reception is complete, HP data is stored in this register [95:64]. </description>
