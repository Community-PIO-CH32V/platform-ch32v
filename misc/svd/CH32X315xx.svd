          <addressOffset>0x133</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_EP_RX_CHAIN_EN</name>
              <description>CHAIN enabled state, corresponding to 4 independent CHAINs</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>	
			<field>
              <name>RB_EP_RX_CHAIN_RES</name>
              <description>CHAIN response state, corresponding to 4 independent CHAINs</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_EP_RX_ERDY_REQ</name>
              <description>It indicates that it is currently in the sending ERDY;
				Writing 1 to that bit will send ERDY, used in non-ERDY_AUTO mode.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_RX_FC_ST</name>
              <description>The endpoint is currently in the flow control state, write 1 to clear it</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_EP_RX_INT_FLAG</name>
              <description>The endpoint is currently interrupted, the bit is read-only, and if all CHAIN_IF is 0, the bit is 0, otherwise it is 1.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
		 </fields>
        </register>

