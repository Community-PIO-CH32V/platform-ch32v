		<register>
          <name>UEP2_TX_CHAIN_ST</name>
          <displayName>UEP2_TX_CHAIN_ST</displayName>
          <description>Endpoint 2 CHAIN status register</description>
          <addressOffset>0xE5</addressOffset>
          <size>0x8</size>
          <resetValue>0x00</resetValue>
          <fields>			
			<field>
              <name>RB_TX_CHAIN_EN</name>
              <description>The currently used CHAIN enables the hardware to 
			  automatically set 1 after the UEP_CHAIN_NUMP register is configured, and the CHAIN is automatically cleared 
			  after the transmission is completed.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>			
			<field>
              <name>RB_TX_CHAIN_IF</name>
              <description>The bit is only written, write 1 to release the current CHAIN_IF;
				The current CHAIN NUMP_EMPTY is 1 to cause this outage.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>			
			<field>
              <name>RB_TX_EOB_LPF</name>
              <description>The EOB/LPF bits in the last pack of DPH of the current CHAIN</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
			<field>
              <name>RB_TX_NUMP_EMPTY</name>
              <description>If the NUMP in the current CHAIN is 0, then the position is 1</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
			<field>
              <name>RB_TX_DPH_PP</name>
              <description>The current status of the PP bit in the DPH.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RB_TX_CHAIN_NO</name>
              <description>The CHAIN serial number that is currently generating the outage.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
		 </fields>
        </register>

