          <name>UEP1_TX_DMA_OFS</name>
          <displayName>UEP1_TX_DMA_OFS</displayName>
          <description>DMA offset length of endpoint 1</description>
          <addressOffset>0xCA</addressOffset>
          <size>0x10</size>
          <resetValue>0x0400</resetValue>
          <fields>			
			<field>
              <name>CHAIN_TX_DMA_OFS</name>
              <description>The offset address of the DPP in the CHAIN.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>						
		 </fields>
        </register>

