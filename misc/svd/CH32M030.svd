    <peripheral>
        <name>OPA</name>
        <description>OPA_CMP</description>
        <groupName>OPA_CMP</groupName>
        <baseAddress>0x40024800</baseAddress>
        <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
        </addressBlock>
        <interrupt>
        <name>OPA</name>
        <description>OPA and CMP global interrupt</description>
        <value>17</value>
        </interrupt>
        <registers>		
        <register>
        <name>QII_CFGR</name>
        <displayName>CFGR</displayName>
        <description>OPA_CMP_QII configuration register</description>
        <addressOffset>0x0</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
        <field>
            <name>QII1_AE</name>
            <description>QII1_CMP enable</description>
            <bitOffset>0</bitOffset>
            <bitWidth>1</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII1_HYPSEL</name>
            <description>QII1_CMP hysteresis selection</description>
            <bitOffset>1</bitOffset>
            <bitWidth>1</bitWidth>
            <access>read-write</access>
        </field>		
        <field>
            <name>QII1_AVSEL</name>
            <description>QII1_OPA gain selection</description>
            <bitOffset>2</bitOffset>
            <bitWidth>1</bitWidth>
            <access>read-write</access>
        </field>		
        <field>
            <name>QII2_AE</name>
            <description>QII2_CMP enable</description>
            <bitOffset>3</bitOffset>
            <bitWidth>1</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_OPAEN</name>
            <description>QII2_OPA enable</description>
            <bitOffset>4</bitOffset>
            <bitWidth>1</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_SESEL</name>
            <description>QII2 single end amplification mode selection</description>
            <bitOffset>5</bitOffset>
            <bitWidth>1</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_AVSEL</name>
            <description>QII2_OPA gain selection</description>
            <bitOffset>6</bitOffset>
            <bitWidth>2</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_HYPSEL</name>
            <description>QII2_CMP hysteresis selection</description>
            <bitOffset>8</bitOffset>
            <bitWidth>3</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_DACEN</name>
            <description>QII2_DAC enable</description>
            <bitOffset>12</bitOffset>
            <bitWidth>1</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_DAC</name>
            <description>QII2_DAC output voltage selection</description>
            <bitOffset>13</bitOffset>
            <bitWidth>4</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_CHNSEL</name>
            <description>Input selection at the negative end of the QII2_CMP</description>
            <bitOffset>18</bitOffset>
            <bitWidth>2</bitWidth>
            <access>read-write</access>
        </field>
        <field>
            <name>QII2_CHPSEL</name>
            <description>Input selection at the positive end of the QII2_CMP</description>
            <bitOffset>20</bitOffset>
            <bitWidth>2</bitWidth>
            <access>read-write</access>
        </field>
          </fields>
        </register> 
        <register>
          <name>ISP_CTLR</name>
