						<bitRange>[2:2]</bitRange>
					</field>
					<field>
						<name>RB_UMS_DM_LEVEL</name>
						<description>judgment speed</description>
						<bitRange>[1:1]</bitRange>
					</field>
					<field>
						<name>RB_UMS_DEV_ATTACH</name>
						<description>port connection status</description>
						<bitRange>[0:0]</bitRange>
					</field>					
				</fields>
			</register>
			<register>
