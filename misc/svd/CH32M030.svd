						<bitRange>[4:4]</bitRange>
					</field>					
					<field>
						<name>RB_UMS_BUS_RST</name>
						<description>USB bus reset status bit</description>
						<bitRange>[3:3]</bitRange>
					</field>					
					<field>
						<name>RB_UMS_SUSPEND</name>
