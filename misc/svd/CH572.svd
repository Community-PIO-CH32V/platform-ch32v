        <peripheral>
            <name>PWMx</name>
            <description>PWMx register</description>
            <groupName>PWMx</groupName>
            <baseAddress>0x40005000</baseAddress>
            <addressBlock>
                <offset>0x00</offset>
                <size>0x400</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>PWMx</name>
                <description>PWMX_IRQHandler</description>
                <value>31</value>
            </interrupt>
            <registers>
                <register>
                    <name>R8_PWM_OUT_EN</name>
                    <description>RW, PWM output enable control</description>
                    <addressOffset>0x00</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_PWM1_OUT_EN</name>
                            <description>RW, PWM1 output enable</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM2_OUT_EN</name>
                            <description>RW, PWM2 output enable</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM3_OUT_EN</name>
                            <description>RW, PWM3 output enable</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM4_OUT_EN</name>
                            <description>RW, PWM4 output enable</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM5_OUT_EN</name>
                            <description>RW, PWM5 output enable</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_PWM_POLAR</name>
                    <description>RW, PWM output polarity control</description>
                    <addressOffset>0x01</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_PWM1_POLAR</name>
                            <description>RW, PWM1 output polarity: 0=default low and high action, 1=default high and low action</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM2_POLAR</name>
                            <description>RW, PWM2 output polarity: 0=default low and high action, 1=default high and low action</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM3_POLAR</name>
                            <description>RW, PWM3 output polarity: 0=default low and high action, 1=default high and low action</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM4_POLAR</name>
                            <description>RW, PWM4 output polarity: 0=default low and high action, 1=default high and low action</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM5_POLAR</name>
                            <description>RW, PWM5 output polarity: 0=default low and high action, 1=default high and low action</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_PWM_CONFIG</name>
                    <description>RW, PWM configuration</description>
                    <addressOffset>0x02</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x0X</resetValue>
                    <fields>
                        <field>
                            <name>RB_PWM_CYCLE_SEL</name>
                            <description>RW, PWM cycle selection: 0=256;128;64;32 clocks, 1=255;127;63;31 clocks</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_CYC_MOD</name>
                            <description>RW, PWM data width mode: 00=8 bits data, 01=7 bits data, 10=6 bits data, 11=5 bits data</description>
                            <bitRange>[2:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM4_5_STAG_EN</name>
                            <description>RW, PWM4/5 stagger output enable: 0=independent output, 1=stagger output</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM4_5_CH</name>
                            <description>RW, PWM4/5 channel output status</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_SYNC_START</name>
                            <description>RW, Sync Start</description>
                            <bitRange>[6:6]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_SYNC_EN</name>
                            <description>RW, Synchronization enablement allows</description>
                            <bitRange>[7:7]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_PWM_DMA_CTRL</name>
                    <description>RW, PWMx DMA control register</description>
                    <addressOffset>0x03</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_DMA_ENABLE</name>
                            <description>RW, DMA enabled (only valid when the data width is 16)</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_DMA_ADDR_LOOP</name>
                            <description>RW, DMA Loop Output Enable</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_DMA_SEL</name>
                            <description>RW, DMA output channel selection when RB_PWM_SYNC_EN=0</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PWM1_3_DATA</name>
                    <description>RW, PWM data retention register group 1</description>
                    <addressOffset>0x04</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0xXXXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R8_PWM1_DATA/R16_PWM1_DATA</name>
                            <description>RW, PWM1 data holding or PWM1 data holding(16bits wide)</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PWM2_DATA/R16_PWM1_DATA</name>
                            <description>RW, PWM2 data holding or PWM1 data holding(16bits wide)</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                        <field>
                            <name>R8_PWM3_DATA/R16_PWM2_DATA</name>
                            <description>RW, PWM3 data holding or PWM2 data holding(16bits wide)</description>
                            <bitRange>[23:16]</bitRange>
                        </field> 
                        <field>
                            <name>R16_PWM2_DATA</name>
                            <description>RW, PWM2 data holding(16bits wide)</description>
                            <bitRange>[31:24]</bitRange>
                        </field>                                               
                    </fields>
                </register>
                <register>
                    <name>R16_PWM3_DATA</name>
                    <description>RW, PWM data retention register group 2</description>
                    <addressOffset>0x08</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0xXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R16_PWM3_DATA</name>
                            <description>RW, PWM3 data retention register</description>
                            <bitRange>[15:0]</bitRange>
                        </field>                                              
                    </fields>
                </register>                
                <register>
                    <name>R32_PWM4_5_DATA</name>
                    <description>RW, PWM data retention register group 3</description>
                    <addressOffset>0x10</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0xXXXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R8_PWM4_DATA/R16_PWM4_DATA</name>
                            <description>RW, PWM4 data holding or PWM4 data holding(16bits wide)</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PWM5_DATA/R16_PWM4_DATA</name>
                            <description>RW, PWM5 data holding or PWM4 data holding(16bits wide)</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                        <field>
                            <name>R16_PWM5_DATA</name>
                            <description>RW, PWM5 data holding(16bits wide)</description>
                            <bitRange>[32:16]</bitRange>
                        </field> 
                    </fields>
                </register>
                <register>
                    <name>R8_PWM_INT_EN</name>
                    <description>RW, PWMx interrupt enable register</description>
                    <addressOffset>0x0C</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_PWM_IE_CYC</name>
                            <description>RW, End of PWM1/2/3 cycle interrupt enable bit</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_CYC_PRE</name>
                            <description>RW, Select the interrupt time point at the end of the PWM cycle</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM1_IE_CYC</name>
                            <description>RW, End of PWM4/5 cycle interrupt enable bit</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_IE_FIFO</name>
                            <description>RW, FIFO data less than 4 interrupt enable bits</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_IE_DMA</name>
                            <description>RW, DMA transfer end interrupt enable bit</description>
                            <bitRange>[5:5]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_IE_OVER</name>
                            <description>RW, FIFO read air interrupt enable bit</description>
                            <bitRange>[6:6]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_PWM_INT_FLAG</name>
                    <description>RW1, PWMx interrupt flag register</description>
                    <addressOffset>0x0D</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_PWM_IF_CYC</name>
                            <description>RW1, PWM1/2/3 cycle end flag</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM1_IF_CYC</name>
                            <description>RW1, PWM4/5 cycle end flag</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_IF_FIFO</name>
                            <description>RW1, FIFO data less than 4 interrupt flag bits</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_IF_DMA</name>
                            <description>RW1, DMA transfer end interrupt flag bit</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_PWM_IF_OVER</name>
                            <description>RW1, FIFO overflow interrupt flag bit</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R16_PWM_CYC_VALUE</name>
                    <description>RW, PWM1/2/3 cycles end register</description>
                    <addressOffset>0x14</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0xXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R16_PWM_CYC_VALUE</name>
                            <description>RW, PWM1/2/3 clock cycle at 16 data widths</description>
                            <bitRange>[15:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R16_PWM_CLOCK_DIV</name>
                    <description>RW, PWM reference clock frequency division coefficient</description>
                    <addressOffset>0x18</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>R16_PWM_CLOCK_DIV</name>
                            <description>RW, DMA data buffer current address</description>
                            <bitRange>[15:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PWM_DMA_NOW</name>
                    <description>RW, Current address of PWMx DMA buffer</description>
                    <addressOffset>0x1C</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0xXXXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R32_PWM_DMA_NOW</name>
                            <description>RW, Current address of PWMx DMA buffer</description>
                            <bitRange>[31:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PWM_DMA_BEG</name>
                    <description>RW, Starting address of PWMx DMA buffer</description>
                    <addressOffset>0x20</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0xXXXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R32_PWM_DMA_BEG</name>
                            <description>RW, Starting address of PWMx DMA buffer</description>
                            <bitRange>[31:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PWM_DMA_END</name>
                    <description>RW, End of PWMx DMA buffer</description>
                    <addressOffset>0x24</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0xXXXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R32_PWM_DMA_END</name>
                            <description>RW, End of PWMx DMA buffer</description>
                            <bitRange>[31:0]</bitRange>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>USBFS</name>
            <description>USBFS register</description>
            <groupName>USBFS</groupName>
            <baseAddress>0x40008000</baseAddress>
            <addressBlock>
                <offset>0x00</offset>
                <size>0x400</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>USBFS</name>
                <description>USB_IRQHandler</description>
                <value>22</value>
            </interrupt>
            <registers>
                <register>
                    <name>R8_USB_CTRL</name>
                    <description>USB base control</description>
                    <addressOffset>0x00</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x06</resetValue>
                    <fields>
                        <field>
                            <name>RB_UC_DMA_EN</name>
                            <description>DMA enable and DMA interrupt enable for USB</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_UC_CLR_ALL</name>
                            <description>force clear FIFO and count of USB</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_UC_RESET_SIE</name>
                            <description>force reset USB SIE, need software clear</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_UC_INT_BUSY</name>
                            <description>enable automatic responding busy for device mode or automatic pause for host mode during interrupt flag UIF_TRANSFER valid</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>MASK_UC_SYS_CTRL</name>
                            <description>bit mask of USB system control</description>
                            <bitRange>[5:4]</bitRange>
                        </field>
                        <field>
                            <name>RB_UC_DEV_PU_EN</name>
                            <description>USB device enable and internal pullup resistance enable</description>
                            <bitRange>[5:5]</bitRange>
                        </field>
                        <field>
                            <name>RB_UC_LOW_SPEED</name>
                            <description>enable USB low speed: 0=12Mbps, 1=1.5Mbps</description>
                            <bitRange>[6:6]</bitRange>
                        </field>
                        <field>
                            <name>RB_UC_HOST_MODE</name>
                            <description>enable USB host mode: 0=device mode, 1=host mode</description>
                            <bitRange>[7:7]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_UDEV_CTRL</name>
                    <description>USB device physical prot control</description>
                    <size>8</size>
                    <addressOffset>0x01</addressOffset>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_UD_PORT_EN</name>
                            <description>enable USB physical port I-O: 0=disable, 1=enable;enable USB port: 0=disable, 1=enable port, automatic disabled if USB device detached</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_UD_HUB0_RESET</name>
                            <description>general purpose bit;control USB bus reset: 0=normal, 1=force bus reset</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_UD_LOW_SPEED</name>
                            <description>enable USB physical port low speed: 0=full speed, 1=low speed;enable USB port low speed: 0=full speed, 1=low speed</description>
                            <bitRange>[2:2]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_UD_DM_PIN</name>
                            <description>ReadOnly: indicate current UDM pin level</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>RB_UD_DP_PIN</name>
                            <description>ReadOnly: indicate current UDP pin level</description>
                            <bitRange>[5:5]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>RB_UD_PD_DIS</name>
                            <description>disable USB UDP-UDM pulldown resistance: 0=enable pulldown, 1=disable</description>
                            <bitRange>[7:7]</bitRange>
                            <access>Read-Only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_USB_INT_EN</name>
                    <description>USB interrupt enable</description>
                    <addressOffset>0x02</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_UIE_BUS_RST__RB_UIE_DETECT</name>
                            <description>enable interrupt for USB bus reset event for USB device mode;enable interrupt for USB device detected event for USB host mode</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIE_TRANSFER</name>
                            <description>enable interrupt for USB transfer completion</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIE_SUSPEND</name>
                            <description>enable interrupt for USB suspend or resume event</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIE_HST_SOF</name>
                            <description>enable interrupt for host SOF timer action for USB host mode</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIE_FIFO_OV</name>
                            <description>enable interrupt for FIFO overflow</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                        <field>
                            <name>RB_MOD_1_WIRE</name>
                            <description>enable USB single line mode</description>
                            <bitRange>[5:5]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIE_DEV_NAK</name>
                            <description>enable interrupt for NAK responded for USB device mode</description>
                            <bitRange>[6:6]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_USB_DEV_AD</name>
                    <description>USB device address</description>
                    <addressOffset>0x03</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>MASK_USB_ADDR</name>
                            <description>bit mask for USB device address</description>
                            <bitRange>[6:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_UDA_GP_BIT</name>
                            <description>general purpose bit</description>
                            <bitRange>[7:7]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_USB_MIS_ST</name>
                    <description>USB miscellaneous status</description>
                    <addressOffset>0x05</addressOffset>
                    <size>8</size>
                    <access>Read-Only</access>
                    <resetValue>0xXX</resetValue>
                    <fields>
                        <field>
                            <name>RB_UMS_DEV_ATTACH</name>
                            <description>RO, indicate device attached status on USB host</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_UMS_DM_LEVEL</name>
                            <description>RO, indicate UDM level saved at device attached to USB host</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_UMS_SUSPEND</name>
                            <description>RO, indicate USB suspend status</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_UMS_BUS_RESET</name>
                            <description>RO, indicate USB bus reset status</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_UMS_R_FIFO_RDY</name>
                            <description>RO, indicate USB receiving FIFO ready status (not empty)</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                        <field>
                            <name>RB_UMS_SIE_FREE</name>
                            <description>RO, indicate USB SIE free status</description>
                            <bitRange>[5:5]</bitRange>
                        </field>
                        <field>
                            <name>RB_UMS_SOF_ACT</name>
                            <description>RO, indicate host SOF timer action status for USB host</description>
                            <bitRange>[6:6]</bitRange>
                        </field>
                        <field>
                            <name>RB_UMS_SOF_PRES</name>
                            <description>RO, indicate host SOF timer presage status</description>
                            <bitRange>[7:7]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_USB_INT_FG</name>
                    <description>USB interrupt flag</description>
                    <addressOffset>0x06</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x20</resetValue>
                    <fields>
                        <field>
                            <name>RB_UIF_BUS_RST/RB_UIF_DETECT</name>
                            <description>RW,bus reset event interrupt flag for USB device mode, direct bit address clear or write 1 to clear;device detected event interrupt flag for USB host mode, direct bit address clear or write 1 to clear</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIF_TRANSFER</name>
                            <description>RW,USB transfer completion interrupt flag, direct bit address clear or write 1 to clear</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIF_SUSPEND</name>
                            <description>RW,USB suspend or resume event interrupt flag, direct bit address clear or write 1 to clear</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIF_HST_SOF</name>
                            <description>RW,host SOF timer interrupt flag for USB host, direct bit address clear or write 1 to clear</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIF_FIFO_OV</name>
                            <description>RW,FIFO overflow interrupt flag for USB, direct bit address clear or write 1 to clear</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                        <field>
                            <name>RB_U_SIE_FREE</name>
                            <description>RO, indicate USB SIE free status</description>
                            <bitRange>[5:5]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>RB_U_TOG_OK</name>
                            <description>RO, indicate current USB transfer toggle is OK</description>
                            <bitRange>[6:6]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>RB_U_IS_NAK</name>
                            <description>RO, indicate current USB transfer is NAK received</description>
                            <bitRange>[7:7]</bitRange>
                            <access>Read-Only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_USB_INT_ST</name>
                    <description>USB interrupt status</description>
                    <addressOffset>0x07</addressOffset>
                    <size>8</size>
                    <access>Read-Only</access>
                    <resetValue>0x3X</resetValue>
                    <fields>
                        <field>
                            <name>MASK_UIS_H_RES__MASK_UIS_ENDP</name>
                            <description>RO, bit mask of current transfer handshake response for USB host mode: 0000=no response, time out from device, others=handshake response PID received;RO, bit mask of current transfer endpoint number for USB device mode</description>
                            <bitRange>[3:0]</bitRange>
                        </field>
                        <field>
                            <name>MASK_UIS_TOKEN</name>
                            <description>RO, bit mask of current token PID code received for USB device mode</description>
                            <bitRange>[5:4]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIS_TOG_OK</name>
                            <description>RO, indicate current USB transfer toggle is OK</description>
                            <bitRange>[6:6]</bitRange>
                        </field>
                        <field>
                            <name>RB_UIS_SETUP_ACT</name>
                            <description>RO, indicate current USB transfer is NAK received for USB device mode</description>
                            <bitRange>[7:7]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_USB_RX_LEN</name>
                    <description>USB receiving length</description>
                    <addressOffset>0x08</addressOffset>
                    <size>8</size>
                    <access>Read-Only</access>
                    <resetValue>0xXX</resetValue>
                    <fields>
                        <field>
                            <name>R8_USB_RX_LEN</name>
                            <description>RO,USB receiving length</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_UEP4_1_MOD</name>
                    <description>endpoint 1/4 mode</description>
                    <addressOffset>0x0C</addressOffset>
