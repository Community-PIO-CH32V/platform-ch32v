                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_SPI_DMA_NOW</name>
                    <description>RW, SPI DMA current address</description>
                    <addressOffset>0x14</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x000XXXXX</resetValue>
                    <fields>
                        <field>
                            <name>RB_SPI_DMA_NOW</name>
