        <peripheral>
            <name>KEYSCAN</name>
            <description>keys scanning</description>
            <groupName>KEYSCAN</groupName>
            <baseAddress>0x40001000</baseAddress>
            <addressBlock>
                <offset>0x64</offset>
                <size>0x16</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>KEYSCAN</name>
                <description>KEYSCAN_IRQHandler</description>
                <value>33</value>
            </interrupt>
            <registers>
                <register>
                    <name>R16_KEY_SCAN_CTRL</name>
                    <description>RW, Key scan control register</description>
                    <addressOffset>0x64</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>RB_SCAN_START_EN</name>
                            <description>RW, Start scanning enable</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_CNT_END</name>
                            <description>RW, Set the number of times to scan to the same key value</description>
                            <bitRange>[3:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_CLK_DIV</name>
                            <description>RW, Scan clock frequency division</description>
                            <bitRange>[7:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PIN_SCAN_EN</name>
                            <description>RW, Enable I/O pins involved in key scanning</description>
                            <bitRange>[12:8]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_1END_WAKE_EN</name>
                            <description>RW, Activate wake-up signal after a single scan</description>
                            <bitRange>[13:13]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLR_WAKEUP_EN</name>
                            <description>RW, Enable automatic clearing of wake-up signal after wake-up</description>
                            <bitRange>[14:14]</bitRange>
                            <access>Read-Only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_KEY_SCAN_INT_EN</name>
                    <description>RW, Press button scan interrupt enable register</description>
                    <addressOffset>0x66</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_KEY_PRESSED_IE</name>
                            <description>RW, Detected key press and interrupted when the same key value is reached the set value</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_1END_IE</name>
                            <description>RW, Interrupt enable after a single scan is completed</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_KEY_SCAN_INT_FLAG</name>
                    <description>RW, Press the button to scan the interrupt flag register</description>
                    <addressOffset>0x67</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_KEY_PRESSED_IF</name>
                            <description>RW, Detected button press, and the same button value reaches the set value for the number of times interrupt flag</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_1END_IF</name>
                            <description>RW, Interrupt flag after word scanning is completed</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_KEY_SCAN_NUMB</name>
                    <description>RW, Scan key number register</description>
                    <addressOffset>0x68</addressOffset>
                    <size>32</size>
                    <access>Read-Only</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>RB_KEY_SCAN_NUMB</name>
                            <description>RO, Current key number value</description>
                            <bitRange>[19:0]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>RB_KEY_SCAN_CNT</name>
                            <description>RO, Current number of key scans</description>
                            <bitRange>[22:20]</bitRange>
                            <access>Read-Only</access>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>GPIO</name>
            <description>General porpose intput output</description>
            <groupName>GPIO</groupName>
            <baseAddress>0x40001000</baseAddress>
            <addressBlock>
                <offset>0x90</offset>
                <size>0x4C</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>GPIOA</name>
                <description>GPIOA_IRQHandler</description>
                <value>17</value>
            </interrupt>           
            <registers>
                <register>
                    <name>R16_PA_INT_EN</name>
                    <description>RW, GPIO PA interrupt enable</description>
                    <addressOffset>0x90</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>R16_PA_INT_EN</name>
                            <description>GPIO PA interrupt enable</description>
                            <bitRange>[15:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R16_PA_INT_MODE</name>
                    <description>RW, GPIO PA interrupt mode: 0=level action, 1=edge action</description>
                    <addressOffset>0x94</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>R16_PA_INT_MODE</name>
                            <description>  GPIO PA interrupt mode</description>
                            <bitRange>[15:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R16_PA_INT_IF</name>
                    <description>RW1, GPIO PA interrupt flag</description>
                    <addressOffset>0x9C</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>R16_PA_INT_IF</name>
                            <description> GPIO PA interrupt flag</description>
                            <bitRange>[15:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PA_DIR</name>
                    <description>RW, GPIO PA I/O direction: 0=in, 1=out</description>
                    <size>32</size>
                    <addressOffset>0xA0</addressOffset>
                    <access>Read-Write</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>R8_PA_DIR_0</name>
                            <description> GPIO PA I/O direction byte 0</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PA_DIR_1</name>
                            <description> GPIO PA I/O direction byte 1</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PA_PIN</name>
                    <description>RO, GPIO PA input</description>
                    <addressOffset>0xA4</addressOffset>
                    <size>32</size>
                    <access>Read-Only</access>
                    <resetValue>0x0000XXXX</resetValue>
                    <fields>
                        <field>
                            <name>R8_PA_PIN_0</name>
                            <description>GPIO PA input byte 0</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PA_PIN_1</name>
                            <description>GPIO PA input byte 1</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PA_OUT</name>
                    <description>RW, GPIO PA output</description>
                    <addressOffset>0xA8</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>R8_PA_OUT_0</name>
                            <description>GPIO PA output byte 0</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PA_OUT_1</name>
                            <description>GPIO PA output byte 1</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PA_CLR</name>
                    <description>WZ, GPIO PA clear output: 0=keep, 1=clear</description>
                    <addressOffset>0xAC</addressOffset>
                    <size>32</size>
                    <access>Write-only</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>R8_PA_CLR_0</name>
                            <description>GPIO PA clear output byte 0</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PA_CLR_1</name>
                            <description>GPIO PA clear output byte 1</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PA_PU</name>
                    <description>RW, GPIO PA pullup resistance enable</description>
                    <addressOffset>0xB0</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>R8_PA_PU_0</name>
                            <description>GPIO PA pullup resistance enable byte 0</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PA_PU_1</name>
                            <description>GPIO PA pullup resistance enable byte 0</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PA_PD_DRV</name>
                    <description>RW, PA pulldown for input or PA driving capability for output</description>
                    <addressOffset>0xB4</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>R8_PA_PD_DRV_0</name>
                            <description>PA pulldown for input or PA driving capability for output byte 0</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PA_PD_DRV_1</name>
                            <description>PA pulldown for input or PA driving capability for output byte 1</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_PA_SET</name>
                    <description>RW, PA port output set register</description>
                    <addressOffset>0xB8</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>R8_PA_SET_0</name>
                            <description>When the corresponding bit of the set register R3_2PA_SET is 0, the output of the PA pin remains unchanged; When it is 1, the PA pin outputs a high level</description>
                            <bitRange>[7:0]</bitRange>
                        </field>
                        <field>
                            <name>R8_PA_SET_1</name>
                            <description>When the corresponding bit of the set register R3_2PA_SET is 0, the output of the PA pin remains unchanged; When it is 1, the PA pin outputs a high level</description>
                            <bitRange>[15:8]</bitRange>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>TMR</name>
            <description>Timer register</description>
            <groupName>TMR</groupName>
            <baseAddress>0x40002400</baseAddress>
            <addressBlock>
                <offset>0x00</offset>
                <size>0x00</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>TMR</name>
                <description>TMR_IRQHandler</description>
                <value>24</value>
            </interrupt>
            <registers>
                <register>
                    <name>R8_TMR_CTRL_MOD</name>
                    <description>RW, TMR mode control</description>
                    <addressOffset>0x400</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x02</resetValue>
                    <fields>
                        <field>
                            <name>RB_TMR_MODE_IN</name>
                            <description>RW, timer in mode: 0=timer/PWM, 1=capture/count</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_ALL_CLEAR</name>
                            <description>RW, force clear timer FIFO and count</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_COUNT_EN</name>
                            <description>RW, timer count enable</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_OUT_EN</name>
                            <description>RW, timer output enable</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_OUT_POLAR/RB_TMR_CAP_COUNT</name>
                            <description>RW, timer PWM output polarity: 0=default low and high action, 1=default high and low action;RW, count sub-mode if RB_TMR_MODE_IN=1: 0=capture, 1=count</description>
                            <bitRange>[4:4]</bitRange>
                        </field>                        
                        <field>
                            <name>RB_TMR_PWM_REPEAT/RB_TMR_CAP_EDGE</name>
                            <description>RW, timer PWM repeat mode: 00=1, 01=4, 10=8, 11-16;RW, timer capture edge mode: 00=disable, 01=edge change, 10=fall to fall, 11-rise to rise</description>
                            <bitRange>[7:6]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_TMR_CTRL_DMA</name>
                    <description>RO/WO, DMA control register</description>
                    <addressOffset>0x01</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_TMR_DMA_ENABLE</name>
                            <description>RW, DMA function enable bit</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_DMA_LOOP</name>
                            <description>RW, Enable bit for DMA address loop function</description>
                            <bitRange>[2:2]</bitRange>
                        </field>                        
                    </fields>
                </register>                 
                <register>
                    <name>R8_TMR_INTER_EN</name>
                    <description>RW, TMR interrupt enable</description>
                    <addressOffset>0x02</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_TMR_IE_CYC_END</name>
                            <description>RW, enable interrupt for timer capture count timeout or PWM cycle end</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IE_DATA_ACT</name>
                            <description>RW, enable interrupt for timer capture input action or PWM trigger</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IE_FIFO_HF</name>
                            <description>RW, enable interrupt for timer FIFO half (capture fifo >=4 or PWM fifo less than 3)</description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IE_DMA_END</name>
                            <description>RW, enable interrupt for timer1/2 DMA completion</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IE_FIFO_OV</name>
                            <description>RW, enable interrupt for timer FIFO overflow</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_TMR_INT_FLAG</name>
                    <description>RW1, TMR interrupt flag</description>
                    <addressOffset>0x06</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_TMR_IF_CYC_END</name>
                            <description>RW1, interrupt flag for timer capture count timeout or PWM cycle end</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IF_DATA_ACT</name>
                            <description>RW1, interrupt flag for timer capture input action or PWM trigger</description>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IF_FIFO_HF</name>
                            <description>RW1, interrupt flag for timer FIFO half (capture fifo >=4 or PWM fifo less than 3 </description>
                            <bitRange>[2:2]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IF_DMA_END</name>
                            <description>RW1, interrupt flag for timer1/2 DMA completion</description>
                            <bitRange>[3:3]</bitRange>
                        </field>
                        <field>
                            <name>RB_TMR_IF_FIFO_OV</name>
                            <description>RW1, interrupt flag for timer FIFO overflow</description>
                            <bitRange>[4:4]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_TMR_FIFO_COUNT</name>
                    <description>RO, TMR FIFO count status</description>
                    <addressOffset>0x07</addressOffset>
                    <size>8</size>
                    <access>Read-Only</access>
                    <resetValue>0x0X</resetValue>
                    <fields>
                        <field>
                            <name>R8_TMR_FIFO_COUNT</name>
                            <description>R0,TMR FIFO count status</description>
                            <bitRange>[3:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_TMR_COUNT</name>
                    <description>RO, TMR current count</description>
                    <addressOffset>0x08</addressOffset>
                    <size>32</size>
                    <access>Read-Only</access>
                    <resetValue>0x0XXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R32_TMR_COUNT</name>
                            <description>RW1,TMR current count</description>
                            <bitRange>[25:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_TMR_CNT_END</name>
                    <description>RW, TMR end count value, only low 26 bit</description>
                    <addressOffset>0x0C</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x0XXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R32_TMR_CNT_END</name>
                            <description>RW1,TMR end count value</description>
                            <bitRange>[31:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_TMR_FIFO</name>
                    <description>RO/WO, TMR FIFO register, only low 26 bit</description>
                    <addressOffset>0x10</addressOffset>
                    <size>32</size>
                    <access>Read-Only</access>
                    <resetValue>0x0XXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>R32_TMR_FIFO</name>
                            <description>RW1,TMR FIFO register</description>
                            <bitRange>[31:0]</bitRange>
                        </field>
                    </fields>
                </register>               
                <register>
                    <name>R32_TMR_DMA_NOW</name>
                    <description>RO, DMA current buffer address</description>
                    <addressOffset>0x14</addressOffset>
                    <size>32</size>
                    <access>Read-Only</access>
                    <resetValue>0x000XXXXX</resetValue>
                    <fields>
                        <field>
                            <name>RB_TMR_DMA_NOW</name>
                            <description>RW, DMA data buffer current address</description>
                            <bitRange>[14:2]</bitRange>
                        </field>                     
                    </fields>
                </register>
                <register>
                    <name>R32_TMR_DMA_BEG</name>
                    <description>RW, DMA start buffer address</description>
                    <addressOffset>0x18</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x000XXXXX</resetValue>
                    <fields>
                        <field>
                            <name>RB_TMR_DMA_BEG</name>
                            <description>RW, The starting address of the DMA data buffer must be aligned with 4 bytes</description>
                            <bitRange>[14:2]</bitRange>
                        </field>                     
                    </fields>
                </register>
                <register>
                    <name>R32_TMR_DMA_END</name>
                    <description>RW, DMA end buffer address</description>
                    <addressOffset>0x1C</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x000XXXXX</resetValue>
                    <fields>
                        <field>
                            <name>RB_TMR_DMA_END</name>
                            <description>RW, DMA data buffer end address (excluding), the address must be aligned with 4 bytes</description>
                            <bitRange>[14:2]</bitRange>
                        </field>                     
                    </fields>
                </register>                              
            </registers>
        </peripheral>
        <peripheral>
            <name>KEYSCAN</name>
            <description>keys scanning</description>
            <groupName>KEYSCAN</groupName>
            <baseAddress>0x40001000</baseAddress>
            <addressBlock>
                <offset>0x64</offset>
                <size>0x16</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>KEYSCAN</name>
                <description>KEYSCAN_IRQHandler</description>
                <value>33</value>
            </interrupt>
            <registers>
                <register>
                    <name>R16_KEY_SCAN_CTRL</name>
                    <description>RW, Key scan control register</description>
                    <addressOffset>0x64</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>RB_SCAN_START_EN</name>
                            <description>RW, Start scanning enable</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_CNT_END</name>
                            <description>RW, Set the number of times to scan to the same key value</description>
                            <bitRange>[3:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_CLK_DIV</name>
                            <description>RW, Scan clock frequency division</description>
                            <bitRange>[7:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PIN_SCAN_EN</name>
                            <description>RW, Enable I/O pins involved in key scanning</description>
                            <bitRange>[12:8]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_1END_WAKE_EN</name>
                            <description>RW, Activate wake-up signal after a single scan</description>
                            <bitRange>[13:13]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLR_WAKEUP_EN</name>
                            <description>RW, Enable automatic clearing of wake-up signal after wake-up</description>
                            <bitRange>[14:14]</bitRange>
                            <access>Read-Only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_KEY_SCAN_INT_EN</name>
                    <description>RW, Press button scan interrupt enable register</description>
                    <addressOffset>0x66</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_KEY_PRESSED_IE</name>
                            <description>RW, Detected key press and interrupted when the same key value is reached the set value</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SCAN_1END_IE</name>
