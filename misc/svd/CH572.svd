                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>R16_SPI_TOTAL_CNT</name>
                            <description>RW, SPI total byte count, only low 12 bit</description>
                            <bitRange>[11:0]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_SPI_FIFO</name>
                    <description>RO/WO, SPI FIFO register</description>
                    <addressOffset>0x10</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0xXX</resetValue>
                    <fields>
                        <field>
                            <name>R8_SPI_FIFO</name>
