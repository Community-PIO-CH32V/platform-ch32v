<?xml version="1.0" encoding="utf-8"?>

<device schemaVersion="1.1"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
    <vendor>WCH Ltd.</vendor>    <!-- device vendor name -->
    <vendorID>WCH</vendorID>    <!-- device vendor short name -->
    <name>CH572SFR</name>    <!-- name of part-->
    <series>CH572</series>    <!-- device series the device belongs to -->
    <version>1.1</version>    <!-- version of this description, adding CMSIS-SVD 1.1 tags -->
    <description>WCH wireless MCU CH572 Family Support, Drivers</description>
    <cpu>        <!-- details about the cpu embedded in the device -->
        <name>RISC-V</name>
        <revision>r0p0</revision>
        <endian>little</endian>
        <mpuPresent>false</mpuPresent>
        <fpuPresent>false</fpuPresent>
        <nvicPrioBits>2</nvicPrioBits>
        <vendorSystickConfig>false</vendorSystickConfig>
    </cpu>
    <addressUnitBits>8</addressUnitBits>    <!-- byte addressable memory -->
    <width>32</width>    <!-- bus width is 32 bits -->
    <!-- default settings implicitly inherited by subsequent sections -->
    <size>32</size>    <!-- this is the default size (number of bits) of all peripherals
                                                                       and register that do not define "size" themselves -->
    <resetValue>0x00000000</resetValue>    <!-- by default all bits of the registers are initialized to 0 on reset -->
    <resetMask>0xFFFFFFFF</resetMask>    <!-- by default all 32Bits of the registers are used -->

    <peripherals>
        <peripheral>
            <name>SYS</name>
            <description>System Control Register</description>
            <groupName>SystemControl</groupName>
            <baseAddress>0x40001000</baseAddress>
            <addressBlock>
                <offset>0x00</offset>
                <size>0x400</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>GPIO_A</name>
                <description>GPIOA_IRQHandler</description>
                <value>17</value>
            </interrupt>
            <interrupt>
                <name>SPI</name>
                <description>SPI_IRQHandler</description>
                <value>19</value>
            </interrupt>
            <interrupt>
                <name>BLEB</name>
                <description>BB_IRQHandler</description>
                <value>20</value>
            </interrupt>
            <interrupt>
                <name>BLEL</name>
                <description>LLE_IRQHandler</description>
                <value>21</value>
            </interrupt>
            <interrupt>
                <name>USB</name>
                <description>USB_IRQHandler</description>
                <value>22</value>
            </interrupt>
            <interrupt>
                <name>TMR</name>
                <description>TMR_IRQHandler</description>
                <value>24</value>
            </interrupt>
            <interrupt>
                <name>UART0</name>
                <description>UART0_IRQHandler</description>
                <value>26</value>
            </interrupt>
            <interrupt>
                <name>UART</name>
                <description>UART_IRQHandler</description>
                <value>27</value>
            </interrupt>
            <interrupt>
                <name>RTC</name>
                <description>RTC_IRQHandler</description>
                <value>28</value>
            </interrupt>
            <interrupt>
                <name>CMP</name>
                <description>CMP_IRQHandler</description>
                <value>29</value>
            </interrupt>
            <interrupt>
                <name>I2C</name>
                <description>I2C_IRQHandler</description>
                <value>30</value>
            </interrupt>
            <interrupt>
                <name>PWMX</name>
                <description>PWMX_IRQHandler</description>
                <value>31</value>
            </interrupt>
            <interrupt>
                <name>KEYSCAN</name>
                <description>KEYSCAN_IRQHandler</description>
                <value>33</value>
            </interrupt>
            <interrupt>
                <name>ENCODER</name>
                <description>ENCODER_IRQHandler</description>
                <value>34</value>
            </interrupt>
            <interrupt>
                <name>WDOG_BAT</name>
                <description>WDOG_BAT_IRQHandler</description>
                <value>35</value>
            </interrupt>
            <registers>
                <register>
                    <name>R32_IWDG_KR</name>
                    <description>WO, Watchdog key register, SAM</description>
                    <addressOffset>0x00</addressOffset>
                    <size>32</size>
                    <access>Write-Only</access>
                    <resetValue>0xXXXXXXXX</resetValue>
                    <fields>
                        <field>
                            <name>IWDG_KR</name>
                            <description>RO,KEY [15:0]: Key value</description>
                            <bitRange>[15:0]</bitRange>
                            <access>Write-Only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R32_IWDG_CFG</name>
                    <description>RW, Watchdog configuration register, SAM</description>
                    <addressOffset>0x04</addressOffset>
                    <size>32</size>
                    <access>Read-Write</access>
                    <resetValue>0x4FFFXFFF</resetValue>
                    <fields>
                        <field>
                            <name>RLR</name>
                            <description>RW, RL [11:0]: Watchdog counter reload</description>
                            <bitRange>[11:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>PR</name>
                            <description>RO, Pre division factor (with write protection)</description>
                            <bitRange>[14:12]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>PVU</name>
                            <description>RO, Configure register update flag bit (with write protection)</description>
                            <bitRange>[15:15]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>COUNT</name>
                            <description>RO, Watchdog countdown counter</description>
                            <bitRange>[27:16]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>STOP_EN</name>
                            <description>RW, Watchdog stop enabled (with write protection)</description>
                            <bitRange>[29:29]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>WR_PROTECT</name>
                            <description>RW, Write protection</description>
                            <bitRange>[30:30]</bitRange>
                            <access>Read-Only</access>
                        </field>
                        <field>
                            <name>IWDG_EN</name>
                            <description>RW, Watch dog start switch: 1: ON; 0: Close</description>
                            <bitRange>[31:31]</bitRange>
                            <access>Read-Only</access>
                        </field>
                    </fields>
                </register>                
                <register>
                    <name>R8_CLK_SYS_CFG</name>
                    <description>RWA, system clock configuration, SAM</description>
                    <addressOffset>0x08</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x0005</resetValue>
                    <fields>
                        <field>
                            <name>RB_CLK_PLL_DIV</name>
                            <description>RWA, output clock divider from PLL or CK32M</description>
                            <bitRange>[4:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLK_SYS_MOD</name>
                            <description>RWA, system clock source mode: 00=divided from 32MHz</description>
                            <bitRange>[7:6]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_HFCK_PWR_CTRL</name>
                    <description>RWA, High frequency clock module power control register, SAM</description>
                    <addressOffset>0x0A</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x14</resetValue>
                    <fields>
                        <field>
                            <name>RB_CLK_XT32M_PON</name>
                            <description>RWA, External 32MHz oscillator HSE power control bit</description>
                            <bitRange>[2:2]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLK_XT32M_KEEP</name>
                            <description>RWA, Used to control the stopping of the clock system in pause mode</description>
                            <bitRange>[3:3]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLK_PLL_PON</name>
                            <description>RWA, PLL power control bit</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_SLP_CLK_OFF0</name>
                    <description>RWA, sleep clock off control byte 0, SAM</description>
                    <addressOffset>0x0C</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_SLP_CLK_TMR</name>
                            <description>RWA, Timer clock source</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_CLK_CMP</name>
                            <description>RWA, CMP clock source</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_CLK_UART</name>
                            <description>RWA, UART clock source</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_KEYSCAN_WAKE</name>
                            <description>RWA, KEYSCAN wakeup enable</description>
                            <bitRange>[7:7]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_SLP_CLK_OFF1</name>
                    <description>RWA, sleep clock off control byte 1, SAM</description>
                    <addressOffset>0x0D</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_SLP_CLK_SPI</name>
                            <description>RWA, close SPI clock</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLK_OFF_AESCCM</name>
                            <description>RWA, close AES_CCM clock</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_CLK_PWMX</name>
                            <description>RWA, close PWMx clock</description>
                            <bitRange>[2:2]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_CLK_I2C</name>
                            <description>RWA, close I2C clock</description>
                            <bitRange>[3:3]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_CLK_USB</name>
                            <description>RWA, close USB clock</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_CLK_BLE</name>
                            <description>RWA, close BLE clock</description>
                            <bitRange>[7:7]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_SLP_WAKE_CTRL</name>
                    <description>RWA, wake control, SAM</description>
                    <addressOffset>0x0E</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x20</resetValue>
                    <fields>
                        <field>
                            <name>RB_SLP_USB_WAKE</name>
                            <description>RWA, enable USB waking</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_ENC_WAKE</name>
                            <description>RWA, enable ENC waking</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_GPIO_EDGE_MODE</name>
                            <description>RWA, GPIO wake-up mode selection</description>
                            <bitRange>[2:2]</bitRange>
                            <access>Read-Write</access>
                        </field>                                                
                        <field>
                            <name>RB_SLP_RTC_WAKE</name>
                            <description>RWA, enable RTC waking</description>
                            <bitRange>[3:3]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_GPIO_WAKE</name>
                            <description>RWA, enable GPIO waking</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SLP_BAT_WAKE</name>
                            <description>RWA, enable BAT waking</description>
                            <bitRange>[5:5]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_WAKE_EV_MODE</name>
                            <description>RWA, event wakeup mode</description>
                            <bitRange>[6:6]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_GPIO_WAKE_MODE</name>
                            <description>RWA, enable edge GPIO wake-up mode</description>
                            <bitRange>[7:7]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_SLP_POWER_CTRL</name>
                    <description>RWA, peripherals power down control, SAM</description>
                    <addressOffset>0x0F</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_WAKE_DLY_MOD</name>
                            <description>RWA, wakeup delay time selection</description>
                            <bitRange>[2:0]</bitRange>
                            <access>Read-Write</access>
                        </field>                       
                        <field>
                            <name>RB_SLP_CLK_RAMX</name>
                            <description>RWA, close main SRAM clock</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_RAM_RET_LV</name>
                            <description>RWA, SRAM retention voltage selection</description>
                            <bitRange>[7:6]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R16_PIN_ALTERNATE</name>
                    <description>RW, function pin alternate configuration</description>
                    <addressOffset>0x18</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x4000</resetValue>
                    <fields>
                        <field>
                            <name>RB_PA_DI_DIS</name>
                            <description>RW, PA0-PA11 channel pin digital input enable</description>
                            <bitRange>[11:0]</bitRange>
                            <access>Read-Write</access>
                        </field>                       
                        <field>
                            <name>RB_UDP_PU_EN</name>
                            <description>RW, Enable internal pull-up resistor for UDP pin of full speed USB</description>
                            <bitRange>[12:12]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PIN_USB_EN</name>
                            <description>RW, Full speed USB pin enable</description>
                            <bitRange>[13:13]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PIN_DEBUG_EN</name>
                            <description>RW, Debugging interface control bit</description>
                            <bitRange>[14:14]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R16_PIN_ALTERNATE_H</name>
                    <description>RW, function pin high alternate configuration</description>
                    <addressOffset>0x1A</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0000</resetValue>
                    <access>Read-Write</access>
                    <fields>
                        <field>
                            <name>RB_UART_RXD</name>
                            <description>RW, RXD alternate pin enable</description>
                            <bitRange>[2:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_UART_TXD</name>
                            <description>RW, TXD alternate pin enable</description>
                            <bitRange>[5:3]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_TMR_PIN</name>
                            <description>RW, Timer function pin mapping selection bit</description>
                            <bitRange>[7:6]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SPI_CS</name>
                            <description>RW, SPI CS function pin mapping selection bit</description>
                            <bitRange>[8:8]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_I2C_PIN</name>
                            <description>RW, I2C function pin mapping selection bit</description>
                            <bitRange>[10:9]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_SPI_CLK</name>
                            <description>RW, SPI CLK function pin mapping selection bit</description>
                            <bitRange>[11:11]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_25M_EN</name>
                            <description>RW, Enable 25MHz clock output</description>
                            <bitRange>[12:12]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_LONG_RST_CFG</name>
                    <description>RWA, Long reset configuration register</description>
                    <addressOffset>0x1C</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_LONG_RST_EN</name>
                            <description>RWA, Long reset enable</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_LONG_TIM_SEL</name>
                            <description>RWA, Long reset duration selection</description>
                            <bitRange>[2:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register> 
                <register>
                    <name>R8_SLP_CLK_OFF2</name>
                    <description>RWA, Sleep clock control register 2</description>
                    <addressOffset>0x1D</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_CLK_OFF_XROM</name>
                            <description>RWA, Turn off the 64M or 600M clock of the FLASH controller</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLK_OFF_DEBUG</name>
                            <description>RWA, Close the two-wire debugging 32M clock</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CLK_OFF_HCLK</name>
                            <description>RWA, Turn off the HCLK clock of the FLASH controller</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Write</access>
                        </field>                      
                    </fields>
                </register> 
                <register>
                    <name>R16_SLP_WAKE_CFG</name>
                    <description>RWA, Sleep clock control register</description>
                    <addressOffset>0x1E</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0100</resetValue>
                    <fields>
                        <field>
                            <name>RB_OSCCLK_RDY_KEEP</name>
                            <description>RWA, During Halt sleep, the peripheral clock remains on</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PRECLK_CNT_EN</name>
                            <description>RWA, When waking up from sleep, it takes a certain amount of time to release HCLK</description>
                            <bitRange>[4:4]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PRECLK_CNT_SEL</name>
                            <description>RWA, Sleep time configuration, sleep duration=number of cycles * Fsys</description>
                            <bitRange>[6:5]</bitRange>
                            <access>Read-Write</access>
                        </field>  
                        <field>
                            <name>RB_ACAUTO_ENABLE</name>
                            <description>RWA, The secure register channel automatically closes</description>
                            <bitRange>[8:8]</bitRange>
                            <access>Read-Write</access>
                        </field>                    
                    </fields>
                </register>                 
                <register>
                    <name>R16_POWER_PLAN</name>
                    <description>RWA, power plan before sleep instruction, SAM</description>
                    <addressOffset>0x20</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x11CF</resetValue>
                    <fields>
                        <field>
                            <name>RB_PWR_XROM</name>
                            <description>RWA, power for FlashROM</description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PWR_RAM12K</name>
                            <description>RWA, SRAM power supply for RAM12K</description>
                            <bitRange>[1:1]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PWR_CORE</name>
                            <description>RWA, power retention for core and base peripherals</description>
                            <bitRange>[2:2]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PWR_EXTEND</name>
                            <description>RWA, power retention for USB and BLE</description>
                            <bitRange>[3:3]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_MAIN_ACT</name>
                            <description>RWA, Main power selection</description>
                            <bitRange>[6:6]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PWR_SYS_EN</name>
                            <description>RWA, power for system</description>
                            <bitRange>[7:7]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PWR_LDO5V_EN</name>
                            <description>RWA, Internal LDO5V control</description>
                            <bitRange>[8:8]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_PWR_PLAN_EN</name>
                            <description>RWA, Enable sleep power planning and control</description>
                            <bitRange>[15:15]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R16_AUX_POWER_ADJ</name>
                    <description>RWA, aux power adjust control, SAM</description>
                    <addressOffset>0x22</addressOffset>
                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0XXX</resetValue>
                    <fields>
                        <field>
                            <name>RB_ULPLDO_ADJ</name>
                            <description>RWA, Output voltage regulation value of auxiliary power supply for ultra-low power consumption LDO</description>
                            <bitRange>[2:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_CFG_IVREF</name>
                            <description>RO, retain. The original value must be kept unchanged when writing</description>
                            <bitRange>[11:8]</bitRange>
                            <access>Read-Write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>R8_BAT_DET_CTRL</name>
                    <description>RWA, battery voltage detector control, SAM</description>
                    <addressOffset>0x24</addressOffset>
                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_PWR_LDO_EN</name>
                            <description>RWA, - </description>
                            <bitRange>[0:0]</bitRange>
                            <access>Read-Write</access>
                        </field>
                        <field>
                            <name>RB_BAT_MON_EN</name>
                            <description>RWA, Enable low-power battery voltage monitoring function</description>
                            <bitRange>[1:1]</bitRange>
