                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_SPI_IE_FIFO_FULL</name>
                            <description>RW, Current FIFO data full interrupt enabled</description>
                            <bitRange>[1:1]</bitRange>
