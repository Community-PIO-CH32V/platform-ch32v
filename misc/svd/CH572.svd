                    <size>8</size>
                    <access>Read-Write</access>
                    <resetValue>0x00</resetValue>
                    <fields>
                        <field>
                            <name>RB_SPI_IF_FIFO_EMPTY</name>
                            <description>RW1, Current FIFO data empty flag bit</description>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>RB_SPI_IE_FIFO_FULL</name>
                            <description>RW1, Current FIFO data full flag</description>
