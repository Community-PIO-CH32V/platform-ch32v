                    <size>16</size>
                    <access>Read-Write</access>
                    <resetValue>0x0002</resetValue>
                    <fields>
                        <field>
                            <name>RB_I2C_TRISE</name>
                            <description>RW, Maximum rise time in Fm/Sm mode (Master mode)</description>
                            <bitRange>[5:0]</bitRange>
                        </field>
                    </fields>
                </register>
