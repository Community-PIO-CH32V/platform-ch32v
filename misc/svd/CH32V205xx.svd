              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>			
            <field>
              <name>SB_GP_BIT_Y</name>
              <description>a generic bit variable Y, defined and used by the application</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SB_FLAG_Z</name>
