					<name>R32_UH_SPLIT_DATA</name>
					<description>USB host SPLIT register</description>
					<addressOffset>0x110</addressOffset>
					<size>0x20</size>
					<access>read-write</access>
					<resetValue>0x00000000</resetValue>
					<fields>
						<field>
							<name>RB_UH_SPLIT_DATA</name>
