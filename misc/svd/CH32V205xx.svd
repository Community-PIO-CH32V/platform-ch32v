							<bitRange>[0:0]</bitRange>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>UEP_TX_EN</name>
					<description>USB endpoint sends the enable register</description>
					<addressOffset>0x10</addressOffset>
					<size>0x10</size>
					<resetValue>0x0000</resetValue>
					<fields>
