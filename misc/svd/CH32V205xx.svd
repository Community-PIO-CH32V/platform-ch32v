							<bitRange>[0:0]</bitRange>
						</field>
						<field>
							<name>RB_UDMS_SUSPEND</name>
							<description>USB suspend status</description>
							<bitRange>[1:1]</bitRange>
						</field>
						<field>
							<name>RB_UDMS_SLEEP</name>
